# Public URL used by the browser and CORS.
# Until DNS is ready, use the VPS IP and the published web port.
BSC_PUBLIC_URL=http://217.76.49.154:8081
BSC_WEB_PORT=8081

# New, isolated PostgreSQL database for this project.
POSTGRES_DB=bsc_performance
POSTGRES_USER=bsc_user
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Cloudflare R2 document storage.
# Create separate buckets for this project so CRM files do not mix.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DOCUMENTS_BUCKET=
R2_KNOWLEDGE_BUCKET=
R2_SIGNED_URL_TTL_SECONDS=900

# Optional email settings. Leave blank to disable outbound mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
