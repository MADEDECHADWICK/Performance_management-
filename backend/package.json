{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "seed:uat-team": "ts-node prisma/scripts/seed-uat-team.ts",
    "recompute:time-entries": "ts-node prisma/scripts/recompute-time-entry-amounts.ts",
    "smoke:live:evaluations-kpis": "node scripts/live-evaluations-kpis-smoke.cjs",
    "test": "jest --config jest.config.cjs",
    "test:security": "jest --config jest.config.cjs test-phase1-security.test.ts --verbose",
    "test:security:watch": "jest --config jest.config.cjs test-phase1-security.test.ts --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:rbac": "jest --config jest.config.cjs -- 1-rbac-access-control.test.ts",
    "test:hr": "jest --config jest.config.cjs -- 2-hr-admin-workflow.test.ts",
    "test:employee": "jest --config jest.config.cjs -- 3-employee-workflow.test.ts",
    "test:partner": "jest --config jest.config.cjs -- 4-partner-workflow.test.ts",
    "test:financial": "jest --config jest.config.cjs -- 5-financial-logic.test.ts",
    "test:kpi": "jest --config jest.config.cjs -- 6-kpi-logic.test.ts",
    "test:module-access": "jest --config jest.config.cjs -- src/services/moduleAccess.service.test.ts",
    "test:module-access:middleware": "jest --config jest.config.cjs -- src/middleware/requireModuleAccess.test.ts",
    "test:require-role-bridge": "jest --config jest.config.cjs -- src/middleware/requireRole.module-policy.test.ts",
    "test:module-access:routes": "jest --config jest.config.cjs -- src/routes/moduleAccess.protected.test.ts",
    "test:finance-access": "jest --config jest.config.cjs -- src/routes/financeDashboard.access.test.ts",
    "test:financial-summary-access": "jest --config jest.config.cjs -- src/routes/financialSummary.access.test.ts",
    "test:route-access-coverage": "jest --config jest.config.cjs -- src/routes/index.access-coverage.test.ts",
    "test:e2e": "jest --config jest.config.cjs -- 7-end-to-end-scenarios.test.ts",
    "test:all": "jest --config jest.config.cjs --coverage --verbose"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^6.19.2",
    "@types/pdfkit": "^0.17.4",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.17.2",
    "pg": "^8.17.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.29",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "prisma": "^6.19.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
