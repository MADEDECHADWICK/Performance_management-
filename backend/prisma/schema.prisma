  task        ImpactAssessmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy Profile              @relation("ImpactAssessmentSubmittedBy", fields: [submittedByProfileId], references: [id], onDelete: Restrict)

  @@index([submittedByProfileId])
  @@map("impact_assessment_responses")
}

model LearningPointLedger {
  id                 Int                     @id @default(autoincrement())
  profileId          Int                     @map("profile_id")
  eventType          LearningPointEventType  @map("event_type")
