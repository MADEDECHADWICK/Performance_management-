  answerSelections LearningQuizAnswerOption[]

  @@index([questionId, displayOrder])
  @@map("learning_quiz_options")
}

model LearningQuizAttempt {
  id           Int                        @id @default(autoincrement())
  quizId       Int                        @map("quiz_id")
  assignmentId Int                        @map("assignment_id")
  attemptNo    Int                        @map("attempt_no")
  score        Decimal                    @default(0) @db.Decimal(5, 2)
  status       LearningQuizAttemptStatus  @default(in_progress)
  startedAt    DateTime                   @default(now()) @map("started_at")
  submittedAt  DateTime?                  @map("submitted_at")
  passedAt     DateTime?                  @map("passed_at")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  quiz       LearningQuiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  assignment LearningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers    LearningQuizAnswer[]

  @@unique([quizId, assignmentId, attemptNo])
  @@index([assignmentId, status])
  @@map("learning_quiz_attempts")
}

model LearningQuizAnswer {
  id             Int      @id @default(autoincrement())
  attemptId      Int      @map("attempt_id")
  questionId     Int      @map("question_id")
  freeTextAnswer String?  @map("free_text_answer") @db.Text
  isCorrect      Boolean? @map("is_correct")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  attempt         LearningQuizAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        LearningQuizQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptions LearningQuizAnswerOption[]

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("learning_quiz_answers")
}

model LearningQuizAnswerOption {
  answerId Int @map("answer_id")
  optionId Int @map("option_id")

  answer LearningQuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option LearningQuizOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([answerId, optionId])
  @@index([optionId])
  @@map("learning_quiz_answer_options")
}

model CertificateTemplate {
  id                   Int      @id @default(autoincrement())
  programVersionId     Int      @map("program_version_id")
  name                 String
  templateDefinition   Json     @default(dbgenerated("'{}'::jsonb")) @map("template_definition")
  backgroundDocumentId Int?     @map("background_document_id")
  signatureDocumentId  Int?     @map("signature_document_id")
  issuedByLabel        String?  @map("issued_by_label")
  isDefault            Boolean  @default(true) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  programVersion     LearningProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
  backgroundDocument Document?              @relation("CertificateTemplateBackground", fields: [backgroundDocumentId], references: [id], onDelete: SetNull)
  signatureDocument  Document?              @relation("CertificateTemplateSignature", fields: [signatureDocumentId], references: [id], onDelete: SetNull)

  issuedCertificates IssuedCertificate[]

  @@index([programVersionId])
  @@index([backgroundDocumentId])
  @@index([signatureDocumentId])
  @@map("certificate_templates")
}

model GlobalCertificateTemplate {
  id                   Int      @id @default(autoincrement())
  key                  String   @unique @default("default")
  name                 String
  templateDefinition   Json     @default(dbgenerated("'{}'::jsonb")) @map("template_definition")
  backgroundDocumentId Int?     @map("background_document_id")
  signatureDocumentId  Int?     @map("signature_document_id")
  issuedByLabel        String?  @map("issued_by_label")
  isActive             Boolean  @default(true) @map("is_active")
  createdByProfileId   Int?     @map("created_by_profile_id")
  updatedByProfileId   Int?     @map("updated_by_profile_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  backgroundDocument Document? @relation("GlobalCertificateTemplateBackground", fields: [backgroundDocumentId], references: [id], onDelete: SetNull)
  signatureDocument  Document? @relation("GlobalCertificateTemplateSignature", fields: [signatureDocumentId], references: [id], onDelete: SetNull)
  createdBy          Profile?  @relation("GlobalCertificateTemplateCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)
  updatedBy          Profile?  @relation("GlobalCertificateTemplateUpdatedBy", fields: [updatedByProfileId], references: [id], onDelete: SetNull)

  issuedCertificates IssuedCertificate[] @relation("IssuedCertificateGlobalTemplate")

  @@index([backgroundDocumentId])
  @@index([signatureDocumentId])
  @@index([createdByProfileId])
  @@index([updatedByProfileId])
  @@index([isActive])
  @@map("global_certificate_templates")
}

model IssuedCertificate {
  id                    Int               @id @default(autoincrement())
  assignmentId          Int               @unique @map("assignment_id")
  certificateTemplateId Int?              @map("certificate_template_id")
  globalCertificateTemplateId Int?        @map("global_certificate_template_id")
  documentId            Int?              @map("document_id")
  certificateNumber     String            @unique @map("certificate_number")
  verificationCode      String            @unique @map("verification_code")
  status                CertificateStatus @default(issued)
  issuedAt              DateTime          @default(now()) @map("issued_at")
  revokedAt             DateTime?         @map("revoked_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  assignment          LearningAssignment @relation("LearningAssignmentCertificate", fields: [assignmentId], references: [id], onDelete: Cascade)
  certificateTemplate CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  globalCertificateTemplate GlobalCertificateTemplate? @relation("IssuedCertificateGlobalTemplate", fields: [globalCertificateTemplateId], references: [id], onDelete: SetNull)
  document            Document?            @relation("IssuedCertificateDocument", fields: [documentId], references: [id], onDelete: SetNull)

  @@index([certificateTemplateId])
  @@index([globalCertificateTemplateId])
  @@index([documentId])
  @@map("issued_certificates")
}

model TrainingFeedback {
  id               Int      @id @default(autoincrement())
  assignmentId     Int      @unique @map("assignment_id")
  trainerProfileId Int?     @map("trainer_profile_id")
  overallRating    Int      @map("overall_rating")
  contentRating    Int      @map("content_rating")
  deliveryRating   Int      @map("delivery_rating")
  relevanceRating  Int      @map("relevance_rating")
  comment          String?  @db.Text
  pointsAwarded    Int      @default(0) @map("points_awarded")
  submittedAt      DateTime @default(now()) @map("submitted_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  assignment LearningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  trainer    Profile?           @relation("TrainingFeedbackTrainer", fields: [trainerProfileId], references: [id], onDelete: SetNull)

  @@index([trainerProfileId])
  @@map("training_feedback")
}

model ImpactAssessmentTask {
