// =============================
// EVALUATIONS
// =============================

model EvaluationCycle {
  id          Int      @id @default(autoincrement())
  cycleName   String   @map("cycle_name")
  description String?
  cycleType   EvaluationCycleType @default(annual) @map("cycle_type")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  departmentId Int?    @map("department_id")

  status EvaluationCycleStatus @default(draft) // v2.1 (was String)

  createdByProfileId Int?     @map("created_by_profile_id")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  definitions       EvaluationDefinition[]
  performanceScores PerformanceScore[]
  assignments       EvaluationAssignment[] @relation("EvaluationCycleAssignments")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  Profile?    @relation("EvaluationCycleCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@map("evaluation_cycles")
}

model EvaluationDefinition {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  cycleId      Int? @map("cycle_id")
  departmentId Int? @map("department_id")
  templateId   Int? @map("template_id")

  enableSelfEvaluation     Boolean @default(false) @map("enable_self_evaluation")
  enablePeerEvaluation     Boolean @default(false) @map("enable_peer_evaluation")
  enableUpwardEvaluation   Boolean @default(false) @map("enable_upward_evaluation")
  enableDownwardEvaluation Boolean @default(false) @map("enable_downward_evaluation")
  enableClientEvaluation   Boolean @default(false) @map("enable_client_evaluation")

  dueDate                   DateTime? @map("due_date")
  processAnonymously        Boolean   @default(false) @map("process_anonymously")
  hideFromDashboard         Boolean   @default(false) @map("hide_from_dashboard")
  excludeFromScore          Boolean   @default(false) @map("exclude_from_score")
  requireEvaluatorSignature Boolean   @default(false) @map("require_evaluator_signature")
  requireEvaluateeSignature Boolean   @default(false) @map("require_evaluatee_signature")

  status EvaluationDefinitionStatus @default(draft)

  createdByProfileId Int?      @map("created_by_profile_id")
  publishedAt        DateTime? @map("published_at")

  questions     Json @default(dbgenerated("'[]'::jsonb"))
  scoringConfig Json @default(dbgenerated("'{}'::jsonb")) @map("scoring_config")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle      EvaluationCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  department Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  template   EvaluationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdBy Profile? @relation("EvalCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  assignments EvaluationAssignment[]

  @@index([status])
  @@index([templateId])
  @@map("evaluation_definitions")
}

model EvaluationAssignment {
  id                     Int @id @default(autoincrement())
  evaluationDefinitionId Int @map("evaluation_definition_id")
  cycleId                Int? @map("cycle_id")

  evaluatorProfileId Int @map("evaluator_profile_id")
  evaluateeProfileId Int @map("evaluatee_profile_id")
  dueDate            DateTime? @map("due_date")

  evaluatorType EvaluatorType @default(manager) @map("evaluator_type")
  relationship  EvaluationRelationship? @default(manager)

  status EvaluationAssignmentStatus @default(pending)

  responses    Json?    @map("responses")
  score        Decimal? @map("score") @db.Decimal(7, 2)
  evidenceUrls String[] @map("evidence_urls")

  evaluatorComments String?   @map("evaluator_comments") @db.Text
  submittedAt       DateTime? @map("submitted_at")

  evaluatorSigned   Boolean   @default(false) @map("evaluator_signed")
  evaluatorSignedAt DateTime? @map("evaluator_signed_at")

  evaluateeAcknowledged   Boolean   @default(false) @map("evaluatee_acknowledged")
  evaluateeAcknowledgedAt DateTime? @map("evaluatee_acknowledged_at")

  rejectionReason String? @map("rejection_reason") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  definition EvaluationDefinition @relation(fields: [evaluationDefinitionId], references: [id], onDelete: Cascade)
  cycle      EvaluationCycle?     @relation("EvaluationCycleAssignments", fields: [cycleId], references: [id], onDelete: SetNull)

  evaluator Profile @relation("EvalEvaluator", fields: [evaluatorProfileId], references: [id], onDelete: Cascade)
  evaluatee Profile @relation("EvalEvaluatee", fields: [evaluateeProfileId], references: [id], onDelete: Cascade)
  responseRecords EvaluationResponse[]

  @@unique([evaluationDefinitionId, evaluatorProfileId, evaluateeProfileId, evaluatorType])
  @@index([evaluateeProfileId, status])
  @@index([cycleId, evaluateeProfileId])
  @@map("evaluation_assignments")
}

model EvaluationTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  templateType String  @map("template_type")
  bscCategory  String? @map("bsc_category")

  competencies Json @default(dbgenerated("'[]'::jsonb"))
  questions    Json @default(dbgenerated("'[]'::jsonb"))

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questionRecords EvaluationQuestion[]
  definitions     EvaluationDefinition[]

  @@index([templateType])
  @@map("evaluation_templates")
}

model EvaluationQuestion {
  id         Int                        @id @default(autoincrement())
  templateId Int                        @map("template_id")
  text       String
  category   EvaluationQuestionCategory
  weight     Decimal                    @db.Decimal(5, 2)
  order      Int                        @map("display_order")
  createdAt  DateTime                   @default(now()) @map("created_at")
  updatedAt  DateTime                   @updatedAt @map("updated_at")

  template EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses EvaluationResponse[]

  @@index([templateId, order])
  @@map("evaluation_questions")
}

model EvaluationResponse {
  id           Int      @id @default(autoincrement())
  assignmentId Int      @map("assignment_id")
  questionId   Int      @map("question_id")
  score        Int
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignment EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question   EvaluationQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, questionId])
  @@index([questionId])
  @@map("evaluation_responses")
}

// =============================
// PERFORMANCE SCORE
// =============================

model PerformanceScore {
  id                Int  @id @default(autoincrement())
  employeeProfileId Int  @map("employee_profile_id")
  evaluationCycleId Int? @map("evaluation_cycle_id")

  period DateTime @map("period")

  revenueScore        Decimal @default(0) @map("revenue_score") @db.Decimal(7, 2)
  profitScore         Decimal @default(0) @map("profit_score") @db.Decimal(7, 2)
  bdScore             Decimal @default(0) @map("bd_score") @db.Decimal(7, 2)
  utilizationScore    Decimal @default(0) @map("utilization_score") @db.Decimal(7, 2)
  jobCompletionScore  Decimal @default(0) @map("job_completion_score") @db.Decimal(7, 2)
  timeToDeliveryScore Decimal @default(0) @map("time_to_delivery_score") @db.Decimal(7, 2)
  financialWeighted   Decimal @default(0) @map("financial_weighted") @db.Decimal(7, 2)
  efficiencyWeighted  Decimal @default(0) @map("efficiency_weighted") @db.Decimal(7, 2)

  evaluationScore      Decimal @default(0) @map("evaluation_score") @db.Decimal(7, 2)
  clientRatingScore    Decimal @default(0) @map("client_rating_score") @db.Decimal(7, 2)
  nonFinancialWeighted Decimal @default(0) @map("non_financial_weighted") @db.Decimal(7, 2)

  totalScore Decimal @default(0) @map("total_score") @db.Decimal(7, 2)
  grade      String? @map("grade")

  calibratedScore       Decimal?  @map("calibrated_score") @db.Decimal(7, 2)
  calibrationNote       String?   @map("calibration_note")
  calibratedByProfileId Int?      @map("calibrated_by_profile_id")
  calibratedAt          DateTime? @map("calibrated_at")

  scoreBreakdown Json    @default(dbgenerated("'{}'::jsonb")) @map("score_breakdown")
  notes          String? @db.Text

  calculatedAt DateTime @default(now()) @map("calculated_at")

  employee     Profile          @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  cycle        EvaluationCycle? @relation(fields: [evaluationCycleId], references: [id], onDelete: SetNull)
  calibratedBy Profile?         @relation("PerformanceScoreCalibratedBy", fields: [calibratedByProfileId], references: [id], onDelete: SetNull)

  @@unique([employeeProfileId, evaluationCycleId, period])
  @@index([employeeProfileId])
  @@index([period])
  @@map("performance_scores")
}

model CheckIn {
  id                Int           @id @default(autoincrement())
  managerProfileId  Int           @map("manager_profile_id")
  employeeProfileId Int           @map("employee_profile_id")
  scheduledAt       DateTime      @map("scheduled_at")
  completedAt       DateTime?     @map("completed_at")
  notes             String?       @db.Text
  actionItems       Json          @default(dbgenerated("'[]'::jsonb")) @map("action_items")
  status            CheckInStatus @default(scheduled)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  manager  Profile @relation("CheckInManager", fields: [managerProfileId], references: [id], onDelete: Cascade)
  employee Profile @relation("CheckInEmployee", fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([managerProfileId, status])
  @@index([employeeProfileId, scheduledAt])
  @@map("check_ins")
}

// =============================
// BALANCED SCORECARD
// =============================

model BalancedScorecardPerspective {
  id               Int      @id @default(autoincrement())
  key              String   @unique
  name             String
  ownerName        String?  @map("owner_name")
  summary          String?  @db.Text
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdByProfileId Int?   @map("created_by_profile_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  goals BalancedScorecardGoal[]

  @@index([sortOrder])
  @@index([isActive])
  @@map("balanced_scorecard_perspectives")
}

model BalancedScorecardGoal {
  id               Int      @id @default(autoincrement())
  key              String   @unique
  perspectiveId    Int      @map("perspective_id")
  title            String
  description      String?  @db.Text
  ownerName        String?  @map("owner_name")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdByProfileId Int?   @map("created_by_profile_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  perspective BalancedScorecardPerspective @relation(fields: [perspectiveId], references: [id], onDelete: Cascade)
  kpis        BalancedScorecardKpi[]
  initiatives BalancedScorecardInitiative[]

  @@index([perspectiveId, sortOrder])
  @@index([isActive])
  @@map("balanced_scorecard_goals")
}

model BalancedScorecardKpi {
  id               Int      @id @default(autoincrement())
  key              String   @unique
  goalId           Int      @map("goal_id")
  metricKey        String   @map("metric_key")
  name             String
  description      String?  @db.Text
  formula          String?  @db.Text
  frequency        String
  unit             String
  weight           Int
  firmTarget       String   @map("firm_target")
  ownerName        String?  @map("owner_name")
  statusLogic      String?  @map("status_logic") @db.Text
  updateFrequency  String?  @map("update_frequency")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdByProfileId Int?   @map("created_by_profile_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  goal        BalancedScorecardGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  initiatives BalancedScorecardInitiative[]

  @@index([goalId, sortOrder])
  @@index([metricKey])
  @@index([isActive])
  @@map("balanced_scorecard_kpis")
}

model BalancedScorecardInitiative {
  id                 Int             @id @default(autoincrement())
  key                String          @unique
  goalId             Int             @map("goal_id")
  kpiId              Int             @map("kpi_id")
  parentInitiativeId Int?            @map("parent_initiative_id")
  scopeRole          String          @map("scope_role")
  title              String
  summary            String?         @db.Text
  ownerName          String?         @map("owner_name")
  timeline           String?
  dueDate            DateTime?       @map("due_date")
  status             DashboardStatus @default(at_risk)
  progress           Int             @default(0)
  sortOrder          Int             @default(0) @map("sort_order")
  isActive           Boolean         @default(true) @map("is_active")
  createdByProfileId Int?            @map("created_by_profile_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  goal             BalancedScorecardGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  kpi              BalancedScorecardKpi        @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  parentInitiative BalancedScorecardInitiative? @relation("BalancedScorecardInitiativeTree", fields: [parentInitiativeId], references: [id], onDelete: SetNull)
  childInitiatives BalancedScorecardInitiative[] @relation("BalancedScorecardInitiativeTree")

  @@index([goalId, sortOrder])
  @@index([kpiId, sortOrder])
  @@index([parentInitiativeId])
  @@index([scopeRole])
  @@index([isActive])
  @@map("balanced_scorecard_initiatives")
}

// =============================
// DASHBOARD METRICS
// =============================

model DashboardMetric {
  id         Int        @id @default(autoincrement())
  metricType MetricType @map("metric_type")
  period     DateTime   @map("period")

  departmentId     Int? @map("department_id")
  partnerProfileId Int? @map("partner_profile_id")
  jobId            Int? @map("job_id")

  value           Decimal  @map("value") @db.Decimal(14, 2)
  target          Decimal? @map("target") @db.Decimal(14, 2)
  variance        Decimal? @map("variance") @db.Decimal(14, 2)
  variancePercent Decimal? @map("variance_percent") @db.Decimal(7, 2)

  status DashboardStatus @default(on_track) // v2.1 (was String)
  trend  String?

  contextData  Json?    @map("context_data")
  calculatedAt DateTime @default(now()) @map("calculated_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  partner    Profile?    @relation("DashboardMetricPartner", fields: [partnerProfileId], references: [id], onDelete: SetNull)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([metricType, period])
  @@index([departmentId, period])
  @@map("dashboard_metrics")
}

// =============================
// NOTIFICATIONS + STATUS TRANSITIONS
// =============================

model Notification {
  id        Int @id @default(autoincrement())
  profileId Int @map("profile_id")

  title   String
  message String
  type    NotificationType @default(info)

  actionRequired  Boolean   @default(false) @map("action_required")
  dueDate         DateTime? @map("due_date")
  escalationLevel Int       @default(1) @map("escalation_level")

  jobId                  Int? @map("job_id")
  clientId               Int? @map("client_id")
  evaluationDefinitionId Int? @map("evaluation_definition_id")
  timeEntryId            Int? @map("time_entry_id")
  workflowAssignmentId   Int? @map("workflow_assignment_id")

  isRead Boolean @default(false) @map("is_read")
  link   String?

  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id      Int              @id @default(autoincrement())
  label   String
  title   String
  message String
  type    NotificationType @default(info)

  actionRequired Boolean @default(false) @map("action_required")
  isActive       Boolean @default(true) @map("is_active")

  createdByProfileId Int?     @map("created_by_profile_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  createdBy Profile? @relation("NotificationTemplateCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("notification_templates")
}

model StatusTransition {
  id         Int    @id @default(autoincrement())
  entityType String @map("entity_type")
  entityId   Int    @map("entity_id")

  fromStatus String @map("from_status")
  toStatus   String @map("to_status")

  changedByProfileId Int?    @map("changed_by_profile_id")
  reason             String?
  metadata           Json?   @map("metadata")

  createdAt DateTime @default(now())

  changedBy Profile? @relation("StatusTransitionChangedBy", fields: [changedByProfileId], references: [id], onDelete: SetNull)

  clientId     Int? @map("client_id")
  jobId        Int? @map("job_id")
  jobCostingId Int? @map("job_costing_id")

  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobCosting JobCosting? @relation(fields: [jobCostingId], references: [id], onDelete: SetNull)

  engagementLetterId Int?              @map("engagement_letter_id")
  engagementLetter   EngagementLetter? @relation(fields: [engagementLetterId], references: [id], onDelete: SetNull)

  @@index([engagementLetterId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("status_transitions")
}

// =============================
// WORKFLOW AUTOMATION
// =============================

model WorkflowDefinition {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  triggerType WorkflowTriggerType @map("trigger_type")
  entityType  String              @map("entity_type") // "Job", "ClientOnboarding", etc.

  conditions      Json  @default(dbgenerated("'{}'::jsonb")) @map("conditions")
  actions         Json  @default(dbgenerated("'[]'::jsonb")) @map("actions")
  escalationRules Json? @map("escalation_rules")

  isActive Boolean @default(true) @map("is_active")
  priority Int     @default(1) @map("priority")

  createdByProfileId Int? @map("created_by_profile_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   Profile?             @relation("WorkflowCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)
  assignments WorkflowAssignment[]

  @@index([triggerType, isActive])
  @@map("workflow_definitions")
}

model WorkflowAssignment {
  id                   Int @id @default(autoincrement())
  workflowDefinitionId Int @map("workflow_definition_id")

  entityType String @map("entity_type")
  entityId   Int    @map("entity_id")

  assignedToProfileId Int                      @map("assigned_to_profile_id")
  status              WorkflowAssignmentStatus @default(pending)

  currentStep    Int  @default(1) @map("current_step")
  completedSteps Json @default(dbgenerated("'[]'::jsonb")) @map("completed_steps")

  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  escalatedAt DateTime? @map("escalated_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  assignee           Profile            @relation("WorkflowAssignee", fields: [assignedToProfileId], references: [id], onDelete: Cascade)

  stepEvents WorkflowStepEvent[] // v2.1

  @@index([assignedToProfileId, status])
  @@index([entityType, entityId])
  @@index([workflowDefinitionId])
  @@map("workflow_assignments")
}

// =============================
// v2.1: WORKFLOW STEP EVENT (NEW - proper workflow history)
// =============================

model WorkflowStepEvent {
  id                   Int @id @default(autoincrement())
  workflowAssignmentId Int @map("workflow_assignment_id")

  stepName String  @map("step_name")
  action   String  @map("action") // "completed"|"rejected"|"escalated"|etc.
  notes    String? @db.Text

  actedByProfileId Int?     @map("acted_by_profile_id")
  actedAt          DateTime @default(now()) @map("acted_at")

  metadata Json? @map("metadata")

  assignment WorkflowAssignment @relation(fields: [workflowAssignmentId], references: [id], onDelete: Cascade)
  actedBy    Profile?           @relation("WorkflowStepActor", fields: [actedByProfileId], references: [id], onDelete: SetNull)

  @@index([workflowAssignmentId, actedAt])
  @@index([actedByProfileId])
  @@map("workflow_step_events")
}

model NotificationDeviceToken {
  id         Int      @id @default(autoincrement())
  profileId  Int      @map("profile_id")
  platform   String
  token      String
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([profileId, platform, token])
  @@index([profileId, active])
  @@map("notification_device_tokens")
}
