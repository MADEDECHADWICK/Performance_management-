}

model ImpactAssessmentResponse {
  id                      Int      @id @default(autoincrement())
  taskId                  Int      @unique @map("task_id")
  submittedByProfileId    Int      @map("submitted_by_profile_id")
  behaviorChangeScore     Int?     @map("behavior_change_score")
  productivityImpactScore Int?     @map("productivity_impact_score")
  qualityImpactScore      Int?     @map("quality_impact_score")
  businessImpactScore     Int?     @map("business_impact_score")
