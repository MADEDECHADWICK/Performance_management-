// =============================
// AUTH + RBAC
// =============================

model User {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  password   String?
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  lastLogin  DateTime?
  resetToken String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile?
  sessions  Session[]
  roles     UserAuthRole[]
  auditLogs AuditLog[]

  @@map("users")
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthRole {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  users       UserAuthRole[]
  permissions AuthRolePermission[]
  viewPermissions AuthRoleViewPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("auth_roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  description String?

  roles AuthRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserAuthRole {
  userId Int
  roleId Int

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AuthRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_auth_roles")
}

model AuthRolePermission {
  roleId       Int
  permissionId Int

  role       AuthRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("auth_role_permissions")
}

model ViewPermission {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles AuthRoleViewPermission[]

  @@map("view_permissions")
}

model AuthRoleViewPermission {
  roleId           Int
  viewPermissionId Int

  role           AuthRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  viewPermission ViewPermission @relation(fields: [viewPermissionId], references: [id], onDelete: Cascade)

  @@id([roleId, viewPermissionId])
  @@index([viewPermissionId])
  @@map("auth_role_view_permissions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  ipAddress  String?  @map("ip_address")
  metadata   Json?    @map("metadata")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================
// ORG / HR
// =============================

model Department {
  id             Int     @id @default(autoincrement())
  name           String
  description    String?
  departmentCode String? @unique @map("department_code")

  departmentHeadId Int?     @map("department_head_id")
  departmentHead   Profile? @relation("DepartmentHead", fields: [departmentHeadId], references: [id], onDelete: SetNull)

  partnerProfileId Int?     @map("partner_profile_id")
  partner          Profile? @relation("DepartmentPartner", fields: [partnerProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles              Profile[]
  jobs                  Job[]
  clients               Client[]
  clientOnboardings     ClientOnboarding[]
  recruitmentCandidates RecruitmentCandidate[]
  revenueProjections    RevenueProjection[]
  evaluationDefinitions EvaluationDefinition[]
  evaluationCycles      EvaluationCycle[]
  dashboardMetrics      DashboardMetric[]
  trainingRecords       TrainingRecord[]
  skillAssessments      SkillAssessment[]
  learningPrograms      LearningProgram[]
  leavePolicyAssignments LeavePolicyAssignment[]
  requisitionRequests   RequisitionRequest[]

  @@index([departmentHeadId])
  @@index([partnerProfileId])
  @@map("departments")
}

model PositionRole {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  billingRate Decimal @default(0) @map("billing_rate") @db.Decimal(12, 2)
  costRate    Decimal @default(0) @map("cost_rate") @db.Decimal(12, 2)

  isActive      Boolean @default(true) @map("is_active")
  defaultAccess Json    @default(dbgenerated("'[]'::jsonb")) @map("default_access")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles            Profile[]
  jobStaffAssignments JobStaffAssignment[]
  jobTimeAllocations  JobTimeAllocation[]
  leavePolicyAssignments LeavePolicyAssignment[]

  @@index([name])
  @@map("position_roles")
}

model Profile {
  id     Int  @id @default(autoincrement())
  userId Int? @unique

  firstName  String  @map("first_name")
  middleName String? @map("middle_name")
  lastName   String  @map("last_name")

  phoneNumber    String? @map("phone_number")
  profilePicture String? @map("profile_picture")

  employeeId  String?   @unique @map("employee_id")
  kraPin      String?   @unique @map("kra_pin")
  nssfNumber  String?   @unique @map("nssf_number")
  dateOfBirth DateTime? @map("date_of_birth")

  status        EmployeeStatus @default(active)
  positionTitle String?        @map("position_title")

  departmentId         Int?
  roleId               Int?         @map("role_id")
  departmentsHeaded    Department[] @relation("DepartmentHead")
  departmentsAsPartner Department[] @relation("DepartmentPartner")

  hireDate       DateTime? @map("hire_date")
  separationDate DateTime? @map("separation_date")

  managerId     Int?      @map("manager_id")
  manager       Profile?  @relation("ProfileManages", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Profile[] @relation("ProfileManages")

  isPartner Boolean @default(false) @map("is_partner")

  jobCostingsManaged JobCosting[] @relation("JobCostingManager")

  jobTimeAllocations JobTimeAllocation[] @relation("JobTimeAllocationEmployee")

  revenueAllocations RevenueAllocation[] @relation("RevenueAllocationEmployee")

  onboardingStatus             OnboardingStatus @default(pending) @map("onboarding_status")
  onboardingChecklistCompleted Boolean          @default(false) @map("onboarding_checklist_completed")
  inductionCompleted           Boolean          @default(false) @map("induction_completed")

  checklistItemsCompleted InductionChecklistItem[] @relation("ChecklistItemCompletedBy")

  clientOnboardingsUploaded ClientOnboarding[] @relation("ClientOnboardingUploader")
  clientOnboardingsReviewed ClientOnboarding[] @relation("ClientOnboardingReviewer")

  clientsAsPartner Client[] @relation("ClientPartner")
  clientsAsManager Client[] @relation("ClientManager")

  backgroundCheckRequired Boolean                @default(true) @map("background_check_required")
  backgroundCheckStatus   BackgroundCheckStatus? @map("background_check_status")
  backgroundCheckDate     DateTime?              @map("background_check_date")

  statusTransitionsChanged StatusTransition[] @relation("StatusTransitionChangedBy")

  financialTarget   Decimal? @map("financial_target") @db.Decimal(14, 2)
  utilizationTarget Decimal  @default(0.75) @map("utilization_target") @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role       PositionRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  documentsUploaded Document[] @relation("DocUploader")
  documentsVerified Document[] @relation("DocVerifier")

  partner Partner?

  jobsAsPartner Job[] @relation("JobsPartner")
  jobsAsManager Job[] @relation("JobsManager")
  jobInvoicesGenerated JobInvoice[] @relation("JobInvoiceGeneratedBy")
  jobInvoicesIssued    JobInvoice[] @relation("JobInvoiceIssuedBy")
  jobInvoiceTemplatesCreated JobInvoiceTemplate[] @relation("JobInvoiceTemplateCreatedBy")
  jobInvoiceStatusChanges    JobInvoiceStatusHistory[] @relation("JobInvoiceStatusChangedBy")
  jobInvoicePaymentApplications JobInvoicePaymentApplication[] @relation("JobInvoicePaymentAppliedBy")

  jobStaffAssignments        JobStaffAssignment[]
  jobStaffAssignmentsCreated JobStaffAssignment[] @relation("JobStaffAssignedBy") // v2.1

  timeEntries         TimeEntry[]
  approvedTimeEntries TimeEntry[] @relation("ApprovedTimeEntries")

  timeOverBudgetRequests    TimeOverBudgetRequest[]
  timeEntryApprovalRequests TimeEntryApprovalRequest[]
  timeEntryApprovalsGiven   TimeEntryApprovalRequest[] @relation("TimeEntryApprovalApprover") // v2.1

  leaveRequests                    LeaveRequest[]       @relation("LeaveRequestEmployee")
  leaveRequestsCurrentApprover     LeaveRequest[]       @relation("LeaveRequestCurrentApprover")
  leaveApprovalStepsAssigned       LeaveApprovalStep[]  @relation("LeaveApprovalStepApprover")
  leaveApprovalStepsDelegatedFrom  LeaveApprovalStep[]  @relation("LeaveApprovalStepDelegatedFrom")
  leavePolicyApprovalRouteStepsAssigned LeavePolicyApprovalRouteStep[] @relation("LeavePolicyApprovalRouteStepApprover")
  leaveBalances                    LeaveBalance[]
  leaveLedgerEntries               LeaveLedgerEntry[]   @relation("LeaveLedgerEntryEmployee")
  leaveLedgerEntriesCreated        LeaveLedgerEntry[]   @relation("LeaveLedgerEntryCreatedBy")
  leavePolicyAssignments           LeavePolicyAssignment[] @relation("LeavePolicyAssignmentProfile")
  leaveDelegationsAsApprover       LeaveDelegation[]    @relation("LeaveDelegationApprover")
  leaveDelegationsAsDelegate       LeaveDelegation[]    @relation("LeaveDelegationDelegate")
  leaveDelegationsCreated          LeaveDelegation[]    @relation("LeaveDelegationCreatedBy")
  requisitionsRequested            RequisitionRequest[] @relation("RequisitionRequester")
  requisitionsCurrentApprover      RequisitionRequest[] @relation("RequisitionCurrentApprover")
  requisitionApprovalStepsAssigned RequisitionApprovalStep[] @relation("RequisitionApprovalStepApprover")
  requisitionsFundsReleased        RequisitionRequest[] @relation("RequisitionReleasedBy")
  requisitionAccountabilitiesSubmitted RequisitionRequest[] @relation("RequisitionAccountabilitySubmittedBy")

  evaluationAssignmentsAsEvaluator EvaluationAssignment[] @relation("EvalEvaluator")
  evaluationAssignmentsAsEvaluatee EvaluationAssignment[] @relation("EvalEvaluatee")
  evaluationDefinitionsCreated     EvaluationDefinition[] @relation("EvalCreatedBy")
  evaluationCyclesCreated          EvaluationCycle[]      @relation("EvaluationCycleCreatedBy")
  projectEvaluationsGiven          ProjectEvaluation[]    @relation("ProjectEvaluationEvaluator")
  projectEvaluationsReceived       ProjectEvaluation[]    @relation("ProjectEvaluationEvaluatee")

  performanceScores           PerformanceScore[]
  calibratedPerformanceScores PerformanceScore[]      @relation("PerformanceScoreCalibratedBy")
  notifications Notification[]

  notificationTemplatesCreated NotificationTemplate[] @relation("NotificationTemplateCreatedBy")

  tasksAssigned Task[] @relation("TaskAssignee")

  feedbackGiven    Feedback[] @relation("FeedbackGiver")
  feedbackReceived Feedback[] @relation("FeedbackRecipient")
  checkInsAsManager CheckIn[] @relation("CheckInManager")
  checkInsAsEmployee CheckIn[] @relation("CheckInEmployee")

  recruitmentCandidatesCreated RecruitmentCandidate[]   @relation("CandidateCreatedBy")
  onboardingCasesAsEmployee    EmployeeOnboardingCase[] @relation("OnboardingEmployee")
  onboardingCasesAsHROwner     EmployeeOnboardingCase[] @relation("OnboardingHROwner")
  onboardingStagesOwned        EmployeeOnboardingStage[] @relation("OnboardingStageOwner")

  offboardingCasesAsEmployee EmployeeOffboardingCase[]  @relation("OffboardingEmployee")
  offboardingCasesAsHROwner  EmployeeOffboardingCase[]  @relation("OffboardingHROwner")
  offboardingItemsCompleted  OffboardingChecklistItem[] @relation("OffboardingItemCompletedBy")

  inductionChecklistsAsEmployee InductionChecklist[] @relation("InductionChecklistEmployee")
  inductionChecklistsAsAssigner InductionChecklist[] @relation("InductionChecklistAssigner")
  onboardingPoliciesCreated      OnboardingPolicy[]   @relation("OnboardingPolicyCreatedBy")
  onboardingPoliciesUpdated      OnboardingPolicy[]   @relation("OnboardingPolicyUpdatedBy")
  clientOnboardingChecklistsAssigned ClientOnboardingChecklist[] @relation("ClientOnboardingChecklistAssigner")
  clientOnboardingChecklistItemsCompleted ClientOnboardingChecklistItem[] @relation("ClientOnboardingChecklistItemCompletedBy")
  trainingRecordsAsEmployee      TrainingRecord[]    @relation("TrainingRecordEmployee")
  trainingRecordsCreated         TrainingRecord[]    @relation("TrainingRecordCreator")
  skillAssessmentsAsEmployee     SkillAssessment[]   @relation("SkillAssessmentEmployee")
  skillAssessmentsAsAssessor     SkillAssessment[]   @relation("SkillAssessmentAssessor")
  knowledgeHubResourceProgressEntries KnowledgeHubResourceProgress[] @relation("KnowledgeHubResourceProgressProfile")
  knowledgeHubQuizAttempts            KnowledgeHubQuizAttempt[]      @relation("KnowledgeHubQuizAttemptProfile")
  learningProgramsCreated             LearningProgram[]              @relation("LearningProgramCreatedBy")
  learningProgramVersionsCreated      LearningProgramVersion[]       @relation("LearningProgramVersionCreatedBy")
  learningProgramVersionsAsTrainer    LearningProgramVersion[]       @relation("LearningProgramVersionTrainer")
  globalCertificateTemplatesCreated   GlobalCertificateTemplate[]    @relation("GlobalCertificateTemplateCreatedBy")
  globalCertificateTemplatesUpdated   GlobalCertificateTemplate[]    @relation("GlobalCertificateTemplateUpdatedBy")
  learningSessionsAsTrainer           LearningSession[]              @relation("LearningSessionTrainer")
