model Proposal {
  id       Int @id @default(autoincrement())
  clientId Int @map("client_id")

  proposalTitle String  @map("proposal_title")
  serviceType   String  @map("service_type")
  proposedFee   Decimal @map("proposed_fee") @db.Decimal(14, 2)
