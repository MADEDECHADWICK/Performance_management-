generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String?
  isActive  Boolean    @default(true)
  isVerified Boolean   @default(false)
  lastLogin DateTime?
  resetToken String?   @unique

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  roles     UserRole[]
  AuditLogs AuditLog[]
  sessions  Session[]
  profile   Profile?

  @@map("users")
}

model UserRole {
  id     Int    @id @default(autoincrement())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  role   String

  @@map("user_roles")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  user       User?    @relation(fields: [userId], references: [id])
  userId     Int?
  action     String
  entityType String?  @map("entity_type")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Department {
  id                 Int      @id @default(autoincrement())
  name               String
  description        String?
  departmentCode    String?  @unique @map("department_code")
  departmentHeadId Int?     @map("department_head_id")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  profiles           Profile[]
  kpis               Kpi[]
  evaluationTeams    EvaluationTeam[]
  adHocEvaluations   AdHocEvaluation[]
  revenueProjections RevenueProjection[]
  clientOnboardings  ClientOnboarding[]
  dashboardMetrics   DashboardMetric[]
  businessPipeline   BusinessPipeline[]

  @@map("departments")
}

model Role {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  billingRate  Decimal  @default(0) @map("billing_rate")
  permissions  Json     @default("[]")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profiles            Profile[]
  jobStaffAssignments JobStaffAssignment[]
  jobTimeAllocations  JobTimeAllocation[]
  kpis                Kpi[]

  @@index([name])
  @@map("roles")
}

model Profile {
  id              Int       @id @default(autoincrement())
  userId          Int?      @unique
  firstName       String    @map("first_name")
  middleName      String?   @map("middle_name")
  lastName        String    @map("last_name")
  email           String?   @unique
  phoneNumber     String?   @map("phone_number")
  profilePicture  String?   @map("profile_picture")
  employeeId      String?   @unique @map("employee_id")
  kraPin          String?   @unique @map("kra_pin")
  nssfNumber      String?   @unique @map("nssf_number")
  dateOfBirth     DateTime? @map("date_of_birth")
  
  status          String    @default("active")
  position        String?
  positionLevel   String?   @map("position_level")
  departmentId    Int?
  roleId          Int?      @map("role_id")
  hireDate        DateTime? @map("hire_date")
  separationDate  DateTime? @map("separation_date")
  managerId       Int?      @map("manager_id")
  costRate        Decimal?  @default(0) @map("cost_rate")
  isPartner       Boolean   @default(false) @map("is_partner")
  
  onboardingStatus           String   @default("pending") @map("onboarding_status")
  onboardingChecklistCompleted Boolean @default(false) @map("onboarding_checklist_completed")
  inductionCompleted        Boolean  @default(false) @map("induction_completed")
  backgroundCheckRequired   Boolean  @default(true) @map("background_check_required")
  backgroundCheckStatus     String?  @map("background_check_status")
  backgroundCheckDate       DateTime? @map("background_check_date")
  
  // Performance targets
  financialTarget           Decimal? @map("financial_target")
  utilizationTarget         Decimal? @default(0.75) @map("utilization_target")
  
  // Document access permissions
  canUploadDocuments        Boolean  @default(true) @map("can_upload_documents")
  canViewAllDocuments       Boolean  @default(false) @map("can_view_all_documents")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role?       @relation(fields: [roleId], references: [id])
  manager    Profile?    @relation("ProfileManages", fields: [managerId], references: [id])
  directReports Profile[] @relation("ProfileManages")

  workLogs                   WorkLog[]                   @relation("ProfileWorkLogs")
  performanceReviews         PerformanceReview[]         @relation("ProfilePerformanceReviews")
  clientEvaluations          ClientEvaluation[]          @relation("ProfileClientEvaluations")
  employeeEvaluations        EmployeeEvaluation[]        @relation("ProfileEmployeeEvaluations")
  employeeGoals              EmployeeGoal[]              @relation("ProfileEmployeeGoals")
  employeeKpiAssignments     EmployeeKpiAssignment[]     @relation("ProfileEmployeeKpiAssignments")
  employeeProjectAllocations EmployeeProjectAllocation[] @relation("ProfileEmployeeProjectAllocations")
  continuousFeedback         ContinuousFeedback[]        @relation("ProfileContinuousFeedback")
  developmentRecommendations DevelopmentRecommendation[] @relation("ProfileDevelopmentRecommendations")
  evaluationActionItems      EvaluationActionItem[]      @relation("ProfileEvaluationActionItems")
  jobStaffAssignments        JobStaffAssignment[]        @relation("ProfileJobStaffAssignments")
  todos                      Todo[]                      @relation("ProfileTodos")
  notifications              Notification[]              @relation("ProfileNotifications")
  partnerProfile             Partner?                    @relation("ProfilePartner")
  partnerJobs                Job[]                       @relation("ProfilePartnerJobs")
  managerJobs                Job[]                       @relation("ProfileManagerJobs")
  tasksAssigned              Task[]                      @relation("ProfileTasksAssigned")
  timeEntries                TimeEntry[]                 @relation("ProfileTimeEntries")
  approvedTimeEntries        TimeEntry[]                 @relation("ProfileApprovedTimeEntries")
  trainingRecords            TrainingRecord[]            @relation("ProfileTrainingRecords")
  knowledgeSessions          KnowledgeSession[]          @relation("ProfileKnowledgeSessions")
  qualityReviews             QualityReview[]             @relation("ProfileQualityReviews")
  reviewsGiven               QualityReview[]             @relation("ProfileReviewsGiven")
  improvementIdeasSubmitted  ImprovementIdea[]           @relation("ProfileImprovementIdeasSubmitted")
  improvementIdeasReviewed   ImprovementIdea[]           @relation("ProfileImprovementIdeasReviewed")
  employeeKpiScores          EmployeeKpiScore[]          @relation("ProfileEmployeeKpiScores")
  evaluatorAssignments       EvaluationAssignment[]      @relation("ProfileEvaluatorAssignments")
  evaluateeAssignments       EvaluationAssignment[]      @relation("ProfileEvaluateeAssignments")
  inductionChecklists        InductionChecklist[]
  jobTimeAllocations         JobTimeAllocation[]
  timeApprovalRequests       TimeEntryApprovalRequest[]
  timeOverBudgetRequests     TimeOverBudgetRequest[]     @relation("ProfileTimeOverBudgetRequests")
  revenueAllocations         RevenueAllocation[]         @relation("ProfileRevenueAllocations")
  performanceScores          PerformanceScore[]          @relation("ProfilePerformanceScores")
  workflowAssignments        WorkflowAssignment[]        @relation("ProfileWorkflowAssignments")
  clientOnboardings          ClientOnboarding[]          @relation("ProfileClientOnboardings")

  @@index([isPartner])
  @@map("profiles")
}

model PartnerCompany {
  id                   Int      @id @default(autoincrement())
  companyName         String   @unique @map("company_name")
  registrationNumber  String?  @map("registration_number")
  taxId               String?  @map("tax_id")
  bankAccountDetails  String?  @db.Text @map("bank_account_details")
  contractTerms       String?  @db.Text @map("contract_terms")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  partners Partner[]

  @@map("partner_companies")
}

model Partner {
  id                    Int      @id @default(autoincrement())
  profileId             Int      @unique @map("profile_id")
  groupId               Int?     @map("group_id")
  commissionRate        Decimal? @default(0) @map("commission_rate")
  performanceThreshold  Decimal? @default(80) @map("performance_threshold")
  groupName             String?  @map("group_name")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  profile Profile         @relation("ProfilePartner", fields: [profileId], references: [id], onDelete: Cascade)
  company PartnerCompany? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  businessPipeline       BusinessPipeline[]
  dashboardMetrics        DashboardMetric[]
  @@index([profileId])
  @@index([groupId])
  @@map("partners")
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ========== CLIENT & ONBOARDING WORKFLOW ==========

model ClientOnboarding {
  id                    Int      @id @default(autoincrement())
  clientName           String   @map("client_name")
  industry             String
  contactPerson        String   @map("contact_person")
  contactEmail         String   @map("contact_email")
  contactPhone         String   @map("contact_phone")
  location             String
  partnerInChargeId    Int?     @map("partner_in_charge_id")
  managerInChargeId    Int?     @map("manager_in_charge_id")
  
  // Engagement Letter Requirement BEFORE client creation
  engagementLetterId   Int      @map("engagement_letter_id")
  engagementLetterStatus String @default("pending") @map("engagement_letter_status")
  
  // Marketing upload → HR notification workflow
  uploadedBy          Int      @map("uploaded_by") // Marketing team
  status              String   @default("pending_hr_review")
  hrReviewerId        Int?     @map("hr_reviewer_id")
  jobCreationStatus   String   @default("pending") @map("job_creation_status")
  
  // Client creation tracking
  clientId            Int?     @unique @map("client_id")
  departmentId        Int?     @map("department_id")
  
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  engagementLetter EngagementLetter @relation(fields: [engagementLetterId], references: [id])
  uploadedByProfile Profile         @relation("ProfileClientOnboardings", fields: [uploadedBy], references: [id])
  department        Department?     @relation(fields: [departmentId], references: [id])
  client            Client?         @relation(fields: [clientId], references: [id])
  
  @@index([status])
  @@index([uploadedBy])
  @@map("client_onboardings")
}

model Client {
  id                  Int      @id @default(autoincrement())
  clientName         String   @map("client_name")
  clientCode         String?  @unique @map("client_code")
  industry           String?
  contactPerson      String?  @map("contact_person")
  contactEmail       String?  @map("contact_email")
  contactPhone       String?  @map("contact_phone")
  address            String?
  location           String?
  partnerInChargeId  Int?     @map("partner_in_charge_id")
  managerInChargeId  Int?     @map("manager_in_charge_id")
  status             String   @default("active")
  onboardingStatus   String   @default("complete") @map("onboarding_status")
  createdBy          Int?     @map("created_by")
  approvedBy         Int?     @map("approved_by")
  approvedAt         DateTime? @map("approved_at")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projects                Project[]
  clientEvaluations       ClientEvaluation[]
  jobs                    Job[]
  engagementLetters       EngagementLetter[]
  clientPayments          ClientPayment[]
  clientSatisfactionSurveys ClientSatisfactionSurvey[]
  proposals               Proposal[]
  clientOnboarding        ClientOnboarding?
  revenueProjections      RevenueProjection[]
  revenueAllocations      RevenueAllocation[]
  statusTransitions       StatusTransition[]

  

  @@map("clients")
}

// ========== JOB & COSTING WORKFLOW ==========

model Job {
  id                    Int       @id @default(autoincrement())
  jobName              String    @map("job_name")
  jobCode              String?   @unique @map("job_code")
  clientId             Int?      @map("client_id")
  partnerId            Int?      @map("partner_id")
  managerId            Int?      @map("manager_id")
  description           String?
  startDate            DateTime? @map("start_date")
  dueDate              DateTime? @map("due_date")
  completionDate       DateTime? @map("completion_date")
  status                String    @default("planned")
  
  // Workflow tracking
  workflowStage         String   @default("client_created") @map("workflow_stage")
  
  assignedTo           Int?      @map("assigned_to")
  departmentId         Int?      @map("department_id")
  estimatedHours       Decimal?  @map("estimated_hours")
  actualHours          Decimal?  @map("actual_hours")
  billableHours        Decimal?  @map("billable_hours")
  billingType          String    @default("hourly") @map("billing_type")
  budgetHours          Decimal?  @default(0) @map("budget_hours")
  fixedFeeAmount      Decimal?  @default(0) @map("fixed_fee_amount")
  jobOwnerId          Int?      @map("job_owner_id")
  priority              String    @default("medium")
  engagementLetterId  Int?      @map("engagement_letter_id")
  costingCompleted     Boolean   @default(false) @map("costing_completed")
  teamAssigned         Boolean   @default(false) @map("team_assigned")
  approvedBy           Int?      @map("approved_by")
  approvedAt           DateTime? @map("approved_at")
  totalAllocatedAmount Decimal?  @default(0) @map("total_allocated_amount")
  profitMarginTarget  Decimal?  @default(0) @map("profit_margin_target")
  budgetedHours        Decimal?  @map("budgeted_hours")
  amountCollected      Decimal?  @default(0) @map("amount_collected")
  fees                  Decimal?  @default(0)
  partnerNotes         String?   @map("partner_notes")
  completionPercentage Int       @default(0) @map("completion_percentage")
  budget                Decimal?
  
  // Budget enforcement
  budgetEnforced          Boolean  @default(true) @map("budget_enforced")
  autoConvertToNonBillable Boolean @default(true) @map("auto_convert_to_non_billable")
  
  // Notification tracking
  lastStatusNotification  DateTime? @map("last_status_notification")
  overdueNotificationSent Boolean  @default(false) @map("overdue_notification_sent")
  
  // Profit/Loss tracking
  calculatedProfit        Decimal? @map("calculated_profit")
  calculatedLoss          Decimal? @map("calculated_loss")
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  partner             Profile?             @relation("ProfilePartnerJobs", fields: [partnerId], references: [id])
  manager             Profile?             @relation("ProfileManagerJobs", fields: [managerId], references: [id])
  client              Client?              @relation(fields: [clientId], references: [id])
  jobStaffAssignments JobStaffAssignment[]
  jobProfitability    JobProfitability[]
  tasks               Task[]
  timeEntries         TimeEntry[]
  qualityReviews      QualityReview[]
  jobCosting          JobCosting?
  engagementLetters   EngagementLetter[]
  clientPayments      ClientPayment[]
  timeApprovalRequests TimeEntryApprovalRequest[]
  clientSatisfactionSurveys ClientSatisfactionSurvey[]
  timeOverBudgetRequests TimeOverBudgetRequest[]
  revenueAllocations  RevenueAllocation[]
  statusTransitions   StatusTransition[]
  budgetCap           BudgetCap?
  dashboardMetrics    DashboardMetric[]

  @@unique([clientId, jobName, startDate])
  @@index([partnerId])
  @@index([managerId])
  @@index([status])
  @@index([partnerId, status])
  @@map("jobs")
}

model JobCosting {
  id                    Int      @id @default(autoincrement())
  jobId                Int      @unique @map("job_id")
  managerId            Int      @map("manager_id")
  
  // Financial metrics
  jobFee               Decimal  @map("job_fee") // From engagement letter
  allocatedCost        Decimal  @default(0) @map("allocated_cost") // Σ(hourly rate × hours)
  remainingBudget      Decimal  @map("remaining_budget") // jobFee - allocatedCost
  profitLossIndicator  String?  @map("profit_loss_indicator") // "profit", "break_even", "loss"
  warningThreshold     Decimal  @default(0.9) @map("warning_threshold") // 90% of fee
  
  totalEstimatedHours  Decimal  @default(0) @map("total_estimated_hours")
  totalEstimatedCost   Decimal  @default(0) @map("total_estimated_cost")
  totalBudgetAmount    Decimal  @default(0) @map("total_budget_amount")
  costingStatus        String   @default("draft") @map("costing_status")
  
  // Approval chain
  approvedByPartner    Int?     @map("approved_by_partner")
  approvedByManager    Int?     @map("approved_by_manager")
  approvedAt           DateTime? @map("approved_at")
  
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  job           Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  allocations   JobTimeAllocation[]
  statusTransitions StatusTransition[]

  @@index([jobId])
  @@index([managerId])
  @@map("job_costings")
}

model BudgetCap {
  id                  Int      @id @default(autoincrement())
  jobId               Int      @unique @map("job_id")
  totalAllocatedHours Decimal  @map("total_allocated_hours")
  capEnforced         Boolean  @default(true) @map("cap_enforced")
  allowOverage        Boolean  @default(false) @map("allow_overage")
  maxOveragePercent   Decimal  @default(0.2) @map("max_overage_percent") // 20%
  autoLockOnExceed    Boolean  @default(true) @map("auto_lock_on_exceed")
  
  job Job @relation(fields: [jobId], references: [id])
  
  @@map("budget_caps")
}

// ========== TIME TRACKING & OVER-BUDGET WORKFLOW ==========

model TimeEntry {
  id              Int       @id @default(autoincrement())
  jobId          Int       @map("job_id")
  taskId         Int?      @map("task_id")
  employeeId     Int       @map("employee_id")
  dateWorked     DateTime  @map("date_worked")
  startTime      String?   @map("start_time")
  endTime        String?   @map("end_time")
  hours           Decimal   @default(0)
  billable        Boolean   @default(true)
  description     String?
  status          String    @default("submitted")
  approvedBy     Int?      @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  allocatedHours Decimal?  @default(0) @map("allocated_hours")
  isOvertime     Boolean   @default(false) @map("is_overtime")
  requiresAdditionalApproval Boolean @default(false) @map("requires_additional_approval")
  timerStartedAt DateTime? @map("timer_started_at")
  timerPausedDuration Int @default(0) @map("timer_paused_duration")
  billableAmount Decimal?  @default(0) @map("billable_amount")
  cost            Decimal?  @default(0)
  profitLoss     Decimal?  @default(0) @map("profit_loss")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  employee Profile  @relation("ProfileTimeEntries", fields: [employeeId], references: [id], onDelete: Cascade)
  approver Profile? @relation("ProfileApprovedTimeEntries", fields: [approvedBy], references: [id])
  
  approvalRequests TimeEntryApprovalRequest[]
  overBudgetRequests TimeOverBudgetRequest[]

  @@unique([employeeId, jobId, taskId, dateWorked])
  @@index([jobId])
  @@index([employeeId])
  @@index([dateWorked])
  @@index([status])
  @@map("time_entries")
}

model TimeOverBudgetRequest {
  id                       Int       @id @default(autoincrement())
  timeEntryId            Int       @map("time_entry_id")
  employeeId             Int       @map("employee_id")
  jobId                  Int       @map("job_id")
  
  // Current vs Allocated
  allocatedHours         Decimal   @map("allocated_hours")
  loggedHours           Decimal   @map("logged_hours")
  requestedAdditional   Decimal   @map("requested_additional")
  totalAfterRequest     Decimal   @map("total_after_request")
  
  // Approval Chain
  billableType           String    @map("billable_type") // "billable", "non_billable", "loss"
  requiresPartnerApproval Boolean  @default(false) @map("requires_partner_approval")
  managerApproved        Boolean   @default(false) @map("manager_approved")
  partnerApproved       Boolean   @default(false) @map("partner_approved")
  
  // Status Tracking
  status                 String    @default("pending")
  autoRejected          Boolean   @default(false) @map("auto_rejected")
  rejectionReason       String?   @map("rejection_reason")
  approvalNotes         String?   @map("approval_notes")
  
  // Financial impact
  estimatedCostImpact   Decimal?  @map("estimated_cost_impact")
  wouldExceedBudget     Boolean   @default(false) @map("would_exceed_budget")
  
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id])
  employee  Profile   @relation("ProfileTimeOverBudgetRequests", fields: [employeeId], references: [id])
  job       Job       @relation(fields: [jobId], references: [id])
  
  @@index([jobId])
  @@index([employeeId])
  @@index([status])
  @@map("time_over_budget_requests")
}

model TimeEntryApprovalRequest {
  id                     Int       @id @default(autoincrement())
  timeEntryId          Int?      @map("time_entry_id")
  jobId                 Int       @map("job_id")
  employeeId            Int       @map("employee_id")
  currentAllocatedHours Decimal  @map("current_allocated_hours")
  currentLoggedHours   Decimal   @map("current_logged_hours")
  additionalHoursRequested Decimal @map("additional_hours_requested")
  justification          String    @db.Text
  requestType           String    @map("request_type")
  status                 String    @default("pending")
  approvedBy            Int?      @map("approved_by")
  approvalNotes         String?   @map("approval_notes")
  approvedAt            DateTime? @map("approved_at")
  requestedAt           DateTime  @default(now()) @map("requested_at")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  timeEntry TimeEntry? @relation(fields: [timeEntryId], references: [id])
  job       Job        @relation(fields: [jobId], references: [id])
  employee  Profile    @relation(fields: [employeeId], references: [id])

  @@index([jobId])
  @@index([employeeId])
  @@index([status])
  @@map("time_entry_approval_requests")
}

// ========== FINANCIAL ALLOCATION MODELS ==========

model RevenueAllocation {
  id                   Int      @id @default(autoincrement())
  jobId               Int      @map("job_id")
  clientPaymentId    Int      @map("client_payment_id")
  employeeId          Int      @map("employee_id")
  
  // Allocation calculation
  employeeBillable     Decimal  @map("employee_billable")
  employeeProfit       Decimal  @map("employee_profit")
  employeeLoss        Decimal  @map("employee_loss")
  
  // Allocation formula: (billable + profit - loss) / total × payment
  totalJobBillable    Decimal  @map("total_job_billable")
  allocationPercentage Decimal @map("allocation_percentage")
  allocatedAmount     Decimal  @map("allocated_amount")
  
  // Period tracking
  allocationMonth     DateTime @map("allocation_month")
  isFinalized         Boolean  @default(false) @map("is_finalized")
  
  // Audit
  calculatedAt        DateTime @default(now()) @map("calculated_at")
  
  job            Job            @relation(fields: [jobId], references: [id])
  clientPayment  ClientPayment  @relation(fields: [clientPaymentId], references: [id])
  employee       Profile        @relation("ProfileRevenueAllocations", fields: [employeeId], references: [id])
  
  client         Client?        @relation(fields: [clientId], references: [id])
  clientId       Int?           @map("client_id")
  @@unique([jobId, clientPaymentId, employeeId])
  @@index([allocationMonth])
  @@map("revenue_allocations")
}

model ClientPayment {
  id               Int      @id @default(autoincrement())
  clientId        Int      @map("client_id")
  jobId           Int?      @map("job_id")
  invoiceNumber   String?   @map("invoice_number")
  paymentAmount   Decimal   @map("payment_amount")
  currency         String   @default("KES")
  paymentDate     DateTime  @map("payment_date")
  paymentMethod   String?   @map("payment_method")
  referenceNumber String?   @map("reference_number")
  notes            String?
  recordedBy      Int?      @map("recorded_by")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  job    Job?   @relation(fields: [jobId], references: [id])
  revenueAllocations RevenueAllocation[]

  @@index([clientId])
  @@index([jobId])
  @@index([paymentDate])
  @@map("client_payments")
}

// ========== PERFORMANCE SCORING MODELS ==========

model PerformanceScore {
  id                    Int      @id @default(autoincrement())
  employeeId           Int      @map("employee_id")
  evaluationCycleId   Int      @map("evaluation_cycle_id")
  period              DateTime @map("period") // e.g., "2024-Q1"
  
  // Financial Score (70%)
  revenueScore         Decimal  @default(0) @map("revenue_score")
  profitScore          Decimal  @default(0) @map("profit_score")
  utilizationScore    Decimal  @default(0) @map("utilization_score")
  financialWeighted   Decimal  @map("financial_weighted") // 70% of total
  
  // Non-Financial Score (30%)
  evaluationScore      Decimal  @default(0) @map("evaluation_score")
  kpiScore            Decimal  @default(0) @map("kpi_score")
  clientRatingScore   Decimal  @default(0) @map("client_rating_score")
  nonFinancialWeighted Decimal @map("non_financial_weighted") // 30% of total
  
  // Combined Score
  totalScore           Decimal  @map("total_score")
  grade                String?  @map("grade") // "A", "B", "C", etc.
  
  // Breakdown for transparency
  scoreBreakdown      Json     @map("score_breakdown") // Store detailed calculation
  notes               String?  @db.Text
  
  calculatedAt         DateTime @default(now()) @map("calculated_at")
  
  employee        Profile          @relation("ProfilePerformanceScores", fields: [employeeId], references: [id])
  evaluationCycle EvaluationCycle? @relation(fields: [evaluationCycleId], references: [id])
  
  @@unique([employeeId, evaluationCycleId, period])
  @@index([employeeId])
  @@index([period])
  @@map("performance_scores")
}

