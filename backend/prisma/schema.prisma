  @@index([profileId, awardedAt])
  @@index([eventType, awardedAt])
  @@map("learning_point_ledger")
}

// =============================
// CLIENTS + ONBOARDING
// =============================

model ClientOnboarding {
  id            Int    @id @default(autoincrement())
  clientName    String @map("client_name")
  industry      String
  contactPerson String @map("contact_person")
  contactEmail  String @map("contact_email")
  contactPhone  String @map("contact_phone")
  location      String

  uploadedByProfileId Int  @map("uploaded_by_profile_id")
  hrReviewerProfileId Int? @map("hr_reviewer_profile_id")

  engagementLetterId Int                    @map("engagement_letter_id")
  status             ClientOnboardingStatus @default(pending_hr_review)

  departmentId Int? @map("department_id")
  clientId     Int? @unique @map("client_id")
  jobId        Int? @unique @map("job_id")

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagementLetter EngagementLetter @relation(fields: [engagementLetterId], references: [id], onDelete: Restrict)

  uploadedBy Profile  @relation("ClientOnboardingUploader", fields: [uploadedByProfileId], references: [id], onDelete: Restrict)
  hrReviewer Profile? @relation("ClientOnboardingReviewer", fields: [hrReviewerProfileId], references: [id], onDelete: SetNull)

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  checklist  ClientOnboardingChecklist?

  @@index([status])
  @@index([uploadedByProfileId])
  @@index([hrReviewerProfileId]) // v2.1 (optional helpful index)
  @@map("client_onboardings")
}

model ClientOnboardingChecklist {
  id                 Int  @id @default(autoincrement())
  clientOnboardingId Int  @unique @map("client_onboarding_id")

  checklistName     String          @default("Standard Client Onboarding") @map("checklist_name")
  status            ChecklistStatus @default(pending)
  totalItems        Int             @default(0) @map("total_items")
  completedItems    Int             @default(0) @map("completed_items")
  completionPercent Decimal         @default(0) @map("completion_percent") @db.Decimal(5, 2)

  assignedByProfileId Int?      @map("assigned_by_profile_id")
  dueDate             DateTime? @map("due_date")
  completedAt         DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clientOnboarding ClientOnboarding @relation(fields: [clientOnboardingId], references: [id], onDelete: Cascade)
  assignedBy       Profile?         @relation("ClientOnboardingChecklistAssigner", fields: [assignedByProfileId], references: [id], onDelete: SetNull)

  items ClientOnboardingChecklistItem[]

  @@index([assignedByProfileId])
  @@map("client_onboarding_checklists")
}

model ClientOnboardingChecklistItem {
  id          Int @id @default(autoincrement())
  checklistId Int @map("checklist_id")

  itemName    String  @map("item_name")
  description String?
  orderIndex  Int     @default(0) @map("order_index")

  isCompleted          Boolean   @default(false) @map("is_completed")
  completedByProfileId Int?      @map("completed_by_profile_id")
  completedAt          DateTime? @map("completed_at")

  requiresDocument Boolean @default(false) @map("requires_document")
  documentId       Int?    @map("document_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  checklist   ClientOnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy Profile?                  @relation("ClientOnboardingChecklistItemCompletedBy", fields: [completedByProfileId], references: [id], onDelete: SetNull)
  document    Document?                 @relation("ClientOnboardingChecklistItemDocument", fields: [documentId], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@map("client_onboarding_checklist_items")
}

model Client {
  id            Int     @id @default(autoincrement())
  clientName    String  @map("client_name")
  clientCode    String? @unique @map("client_code")
  industry      String?
  contactPerson String? @map("contact_person")
  contactEmail  String? @map("contact_email")
  contactPhone  String? @map("contact_phone")
  address       String?
  location      String?

  departmentId     Int? @map("department_id")
  partnerProfileId Int? @map("partner_profile_id")
  managerProfileId Int? @map("manager_profile_id")

  status    ClientStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  partner    Profile?    @relation("ClientPartner", fields: [partnerProfileId], references: [id], onDelete: SetNull)
  manager    Profile?    @relation("ClientManager", fields: [managerProfileId], references: [id], onDelete: SetNull)

  engagementLetters   EngagementLetter[]
  jobs                Job[]
  requisitionRequests RequisitionRequest[]
  payments            ClientPayment[]
  jobInvoices         JobInvoice[]
  receivableFollowUps ReceivableFollowUpAction[]
  statusTransitions   StatusTransition[]
  onboarding          ClientOnboarding?

  satisfactionSurveys ClientSatisfactionSurvey[]
  proposals           Proposal[]
  revenueProjections  RevenueProjection[]

  @@index([departmentId])
  @@index([status])
  @@map("clients")
}

model EngagementLetter {
  id       Int @id @default(autoincrement())
  clientId Int @map("client_id")

  documentId Int?      @map("document_id")
  document   Document? @relation("EngagementLetterDocument", fields: [documentId], references: [id], onDelete: SetNull)

  jobTitle       String? @map("job_title")
  engagementType String  @map("engagement_type")

  feeAmount Decimal? @map("fee_amount") @db.Decimal(14, 2)
  currency  String   @default("KES")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  scopeDescription String? @map("scope_description") @db.Text
  termsConditions  String? @map("terms_conditions") @db.Text

  uploadedByProfileId Int? @map("uploaded_by_profile_id")
  approvedByProfileId Int? @map("approved_by_profile_id")

  uploadedBy Profile?  @relation("EngagementLetterUploader", fields: [uploadedByProfileId], references: [id], onDelete: SetNull)
  approvedBy Profile?  @relation("EngagementLetterApprover", fields: [approvedByProfileId], references: [id], onDelete: SetNull)
  approvedAt DateTime? @map("approved_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status EngagementLetterStatus @default(uploaded)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  onboardings       ClientOnboarding[]
  job               Job?
  statusTransitions StatusTransition[]

  @@index([clientId])
  @@index([status])
  @@index([uploadedByProfileId])
  @@index([approvedByProfileId])
  @@map("engagement_letters")
}

// =============================
// JOBS + COSTING + TASKS + TIME
// =============================

model Job {
  id          Int     @id @default(autoincrement())
  jobName     String  @map("job_name")
  jobCode     String? @unique @map("job_code")
  description String?

  clientId     Int? @map("client_id")
  departmentId Int? @map("department_id")

  partnerProfileId Int? @map("partner_profile_id")
  managerProfileId Int? @map("manager_profile_id")

  startDate      DateTime? @map("start_date")
  dueDate        DateTime? @map("due_date")
  completionDate DateTime? @map("completion_date")
  status         JobStatus @default(planned)

  collectionStage           JobCollectionStage @default(not_ready) @map("collection_stage")
  readyForCollectionAt      DateTime?          @map("ready_for_collection_at")
  receivableOwnerProfileId  Int?               @map("receivable_owner_profile_id")
  receivableOwnerAssignedAt DateTime?          @map("receivable_owner_assigned_at")

  timeEntryApprovalRequests TimeEntryApprovalRequest[]
  timeOverBudgetRequests    TimeOverBudgetRequest[]

  dashboardMetrics DashboardMetric[]

  priority Priority @default(medium)

  billingType    BillingType @default(hourly) @map("billing_type")
  fixedFeeAmount Decimal     @default(0) @map("fixed_fee_amount") @db.Decimal(14, 2)
  currency       String      @default("KES")
  budgetHours    Decimal     @default(0) @map("budget_hours") @db.Decimal(10, 2)

  engagementLetterId Int? @unique @map("engagement_letter_id")

  costingCompleted Boolean @default(false) @map("costing_completed")
  teamAssigned     Boolean @default(false) @map("team_assigned")

  clientOnboarding ClientOnboarding?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  partner         Profile? @relation("JobsPartner", fields: [partnerProfileId], references: [id], onDelete: SetNull)
  manager         Profile? @relation("JobsManager", fields: [managerProfileId], references: [id], onDelete: SetNull)
  receivableOwner Profile? @relation("ReceivableOwner", fields: [receivableOwnerProfileId], references: [id], onDelete: SetNull)

  engagementLetter EngagementLetter? @relation(fields: [engagementLetterId], references: [id], onDelete: SetNull)

  staffing            JobStaffAssignment[]
  jobCosting          JobCosting?
  requisitionRequests RequisitionRequest[]
  tasks               Task[]
  timeEntries         TimeEntry[]
  payments            ClientPayment[]
  invoices            JobInvoice[]
  receivableFollowUps ReceivableFollowUpAction[]
  revenueAllocations  RevenueAllocation[]
  statusTransitions   StatusTransition[]

  surveys            ClientSatisfactionSurvey[]
  projectEvaluations ProjectEvaluation[]
  feedbackEntries    Feedback[]

  @@index([status])
  @@index([partnerProfileId])
  @@index([managerProfileId])
  @@index([clientId])
  @@index([receivableOwnerProfileId])
  @@map("jobs")
}

model ProjectEvaluation {
  id Int @id @default(autoincrement())

  jobId              Int @map("job_id")
  evaluateeProfileId Int @map("evaluatee_profile_id")
  evaluatorProfileId Int @map("evaluator_profile_id")

  evaluatorType EvaluatorType           @default(manager) @map("evaluator_type")
  status        ProjectEvaluationStatus @default(draft)

  scores       Json      @default(dbgenerated("'{}'::jsonb"))
  overallScore Decimal?  @map("overall_score") @db.Decimal(7, 2)
  comments     String?   @db.Text
  submittedAt  DateTime? @map("submitted_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evaluatee Profile @relation("ProjectEvaluationEvaluatee", fields: [evaluateeProfileId], references: [id], onDelete: Cascade)
  evaluator Profile @relation("ProjectEvaluationEvaluator", fields: [evaluatorProfileId], references: [id], onDelete: Cascade)

  @@unique([jobId, evaluateeProfileId, evaluatorProfileId, evaluatorType])
  @@index([jobId])
  @@index([evaluateeProfileId])
  @@index([evaluatorProfileId])
  @@index([status])
  @@map("project_evaluations")
}

model Task {
  id          Int     @id @default(autoincrement())
  jobId       Int     @map("job_id")
  title       String
  description String?

  assignedToProfileId Int?     @map("assigned_to_profile_id")
  estimatedHours      Decimal? @map("estimated_hours") @db.Decimal(10, 2)

  billable Boolean    @default(true)
  status   TaskStatus @default(pending)
  priority Priority   @default(medium)

  dueDate DateTime? @map("due_date")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignee Profile? @relation("TaskAssignee", fields: [assignedToProfileId], references: [id], onDelete: SetNull)

  timeEntries TimeEntry[]
  jobInvoices JobInvoice[] @relation("JobInvoiceMilestoneTask")

  @@index([jobId])
  @@index([assignedToProfileId])
  @@index([status])
  @@map("tasks")
}

model JobStaffAssignment {
  id                Int @id @default(autoincrement())
  jobId             Int @map("job_id")
  employeeProfileId Int @map("employee_profile_id")

  assignedRoleId     Int     @map("assigned_role_id")
  assignedHourlyRate Decimal @map("assigned_hourly_rate") @db.Decimal(12, 2)

  roleSnapshot Json?    @map("role_snapshot")
  roleOnJob    String?  @map("role_on_job")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  assignedByProfileId Int?     @map("assigned_by_profile_id") // v2.1: now linked
  assignedBy          Profile? @relation("JobStaffAssignedBy", fields: [assignedByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job      Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee Profile      @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  role     PositionRole @relation(fields: [assignedRoleId], references: [id], onDelete: Restrict)

  @@unique([jobId, employeeProfileId])
  @@index([jobId])
  @@index([employeeProfileId])
  @@index([assignedByProfileId]) // v2.1
  @@map("job_staff_assignments")
}

model JobCosting {
  id               Int @id @default(autoincrement())
  jobId            Int @unique @map("job_id")
  managerProfileId Int @map("manager_profile_id")

  jobFee   Decimal @map("job_fee") @db.Decimal(14, 2)
  currency String  @default("KES")

  allocatedCost   Decimal @default(0) @map("allocated_cost") @db.Decimal(14, 2)
  remainingBudget Decimal @default(0) @map("remaining_budget") @db.Decimal(14, 2)

  profitLossIndicator String? @map("profit_loss_indicator")
  warningThreshold    Decimal @default(0.90) @map("warning_threshold") @db.Decimal(5, 2)

  totalEstimatedHours Decimal @default(0) @map("total_estimated_hours") @db.Decimal(10, 2)
  totalEstimatedCost  Decimal @default(0) @map("total_estimated_cost") @db.Decimal(14, 2)

  costingStatus JobCostingStatus @default(draft) @map("costing_status") // v2.1 (was String)

  approvedByPartnerProfileId Int?      @map("approved_by_partner_profile_id")
  approvedAt                 DateTime? @map("approved_at")

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  manager Profile @relation("JobCostingManager", fields: [managerProfileId], references: [id], onDelete: Restrict)

  allocations       JobTimeAllocation[]
  budgetCap         BudgetCap?
  statusTransitions StatusTransition[]

  @@index([managerProfileId])
  @@map("job_costings")
}

model JobTimeAllocation {
  id                Int @id @default(autoincrement())
  jobCostingId      Int @map("job_costing_id")
  employeeProfileId Int @map("employee_profile_id")
  roleId            Int @map("role_id")

  allocatedHours Decimal @default(0) @map("allocated_hours") @db.Decimal(10, 2)
  hourlyRate     Decimal @default(0) @map("hourly_rate") @db.Decimal(12, 2)
  estimatedCost  Decimal @default(0) @map("estimated_cost") @db.Decimal(14, 2)

  billable        Boolean @default(true)
  taskDescription String? @map("task_description")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCosting JobCosting   @relation(fields: [jobCostingId], references: [id], onDelete: Cascade)
  employee   Profile      @relation("JobTimeAllocationEmployee", fields: [employeeProfileId], references: [id], onDelete: Cascade)
  role       PositionRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([jobCostingId, employeeProfileId, roleId])
  @@index([jobCostingId])
  @@map("job_time_allocations")
}

model BudgetCap {
  id           Int @id @default(autoincrement())
  jobCostingId Int @unique @map("job_costing_id")

  totalAllocatedHours Decimal @default(0) @map("total_allocated_hours") @db.Decimal(10, 2)

  capEnforced       Boolean @default(true) @map("cap_enforced")
  allowOverage      Boolean @default(false) @map("allow_overage")
  maxOveragePercent Decimal @default(0.20) @map("max_overage_percent") @db.Decimal(5, 2)
  autoLockOnExceed  Boolean @default(true) @map("auto_lock_on_exceed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCosting JobCosting @relation(fields: [jobCostingId], references: [id], onDelete: Cascade)

  @@map("budget_caps")
}

model TimeEntry {
  id                Int  @id @default(autoincrement())
  jobId             Int  @map("job_id")
  taskId            Int? @map("task_id")
  employeeProfileId Int  @map("employee_profile_id")

  dateWorked DateTime @map("date_worked")

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  hours       Decimal @default(0) @db.Decimal(10, 2)
  billable    Boolean @default(true)
  description String?

  status TimeEntryStatus @default(submitted)

  approvedByProfileId Int?      @map("approved_by_profile_id")
  approvedAt          DateTime? @map("approved_at")
  rejectionReason     String?   @map("rejection_reason")

  billableAmount Decimal @default(0) @map("billable_amount") @db.Decimal(14, 2)
  costAmount     Decimal @default(0) @map("cost_amount") @db.Decimal(14, 2)
  profitLoss     Decimal @default(0) @map("profit_loss") @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  employee Profile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  approver Profile? @relation("ApprovedTimeEntries", fields: [approvedByProfileId], references: [id], onDelete: SetNull)

  approvalRequests   TimeEntryApprovalRequest[]
  overBudgetRequests TimeOverBudgetRequest[]
  leaveSegments      LeaveRequestSegment[]

  /// Business rule (enforced in service layer):
  /// Only allow time entry creation when a JobStaffAssignment exists for (employeeProfileId, jobId).

  @@index([employeeProfileId, dateWorked])
  @@index([employeeProfileId, jobId, dateWorked])
  @@index([jobId, dateWorked])
  @@index([jobId]) // optional (hot FK lookups)
  @@index([taskId])
  @@map("time_entries")
}

model TimeEntryApprovalRequest {
  id                Int  @id @default(autoincrement())
  timeEntryId       Int? @map("time_entry_id")
  jobId             Int  @map("job_id")
  employeeProfileId Int  @map("employee_profile_id")

  currentAllocatedHours    Decimal @map("current_allocated_hours") @db.Decimal(10, 2)
  currentLoggedHours       Decimal @map("current_logged_hours") @db.Decimal(10, 2)
  additionalHoursRequested Decimal @map("additional_hours_requested") @db.Decimal(10, 2)

  justification String                       @db.Text
  requestType   TimeEntryApprovalRequestType @map("request_type")

  status              TimeEntryApprovalRequestStatus @default(pending)
  approvedByProfileId Int?                           @map("approved_by_profile_id")
  approvalNotes       String?                        @map("approval_notes")
  approvedAt          DateTime?                      @map("approved_at")
  requestedAt         DateTime                       @default(now()) @map("requested_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntry TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee  Profile    @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  approver Profile? @relation("TimeEntryApprovalApprover", fields: [approvedByProfileId], references: [id], onDelete: SetNull) // v2.1

  @@index([jobId])
  @@index([employeeProfileId])
  @@index([status])
  @@index([approvedByProfileId]) // v2.1
  @@map("time_entry_approval_requests")
}

model TimeOverBudgetRequest {
  id                Int @id @default(autoincrement())
  timeEntryId       Int @map("time_entry_id")
  employeeProfileId Int @map("employee_profile_id")
  jobId             Int @map("job_id")

  allocatedHours      Decimal @map("allocated_hours") @db.Decimal(10, 2)
  loggedHours         Decimal @map("logged_hours") @db.Decimal(10, 2)
  requestedAdditional Decimal @map("requested_additional") @db.Decimal(10, 2)
  totalAfterRequest   Decimal @map("total_after_request") @db.Decimal(10, 2)

  billableType            BillableType @default(billable) @map("billable_type")
  requiresPartnerApproval Boolean      @default(false) @map("requires_partner_approval")

  managerApproved Boolean @default(false) @map("manager_approved")
  partnerApproved Boolean @default(false) @map("partner_approved")

  status OverBudgetRequestStatus @default(pending)

  autoRejected    Boolean @default(false) @map("auto_rejected")
  rejectionReason String? @map("rejection_reason")
  approvalNotes   String? @map("approval_notes")

  estimatedCostImpact Decimal? @map("estimated_cost_impact") @db.Decimal(14, 2)
  wouldExceedBudget   Boolean  @default(false) @map("would_exceed_budget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  employee  Profile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([employeeProfileId])
  @@index([status])
  @@map("time_over_budget_requests")
}

