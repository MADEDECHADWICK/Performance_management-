model JobInvoice {
  id                   Int              @id @default(autoincrement())
  jobId                Int              @map("job_id")
  clientId             Int              @map("client_id")
  milestoneTaskId      Int?             @unique @map("milestone_task_id")
  jobInvoiceTemplateId Int?             @map("job_invoice_template_id")
  generatedByProfileId Int?             @map("generated_by_profile_id")
  issuedByProfileId    Int?             @map("issued_by_profile_id")
  documentId           Int?             @map("document_id")
  invoiceNumber        String           @unique @map("invoice_number")
  title                String
  description          String?          @db.Text
  status               JobInvoiceStatus @default(draft)
  currency             String           @default("KES")
  expectedPercent      Decimal?         @map("expected_percent") @db.Decimal(5, 2)
  subtotalAmount       Decimal          @default(0) @map("subtotal_amount") @db.Decimal(14, 2)
  taxAmount            Decimal          @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount          Decimal          @default(0) @map("total_amount") @db.Decimal(14, 2)
  amountPaid           Decimal          @default(0) @map("amount_paid") @db.Decimal(14, 2)
  amountOutstanding    Decimal          @default(0) @map("amount_outstanding") @db.Decimal(14, 2)
  dueDate              DateTime?        @map("due_date")
  generatedAt          DateTime?        @map("generated_at")
  issuedAt             DateTime?        @map("issued_at")
  paidAt               DateTime?        @map("paid_at")
  voidedAt             DateTime?        @map("voided_at")
  notes                String?          @db.Text
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  job             Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  milestoneTask   Task?               @relation("JobInvoiceMilestoneTask", fields: [milestoneTaskId], references: [id], onDelete: SetNull)
  template        JobInvoiceTemplate? @relation(fields: [jobInvoiceTemplateId], references: [id], onDelete: SetNull)
  generatedBy     Profile?            @relation("JobInvoiceGeneratedBy", fields: [generatedByProfileId], references: [id], onDelete: SetNull)
  issuedBy        Profile?            @relation("JobInvoiceIssuedBy", fields: [issuedByProfileId], references: [id], onDelete: SetNull)
  document        Document?           @relation("JobInvoiceDocument", fields: [documentId], references: [id], onDelete: SetNull)
  lines           JobInvoiceLine[]
  statusHistory   JobInvoiceStatusHistory[]
  paymentApplications JobInvoicePaymentApplication[]

  @@index([jobId, status])
  @@index([clientId, status])
  @@index([jobInvoiceTemplateId])
  @@index([generatedByProfileId])
  @@index([issuedByProfileId])
  @@index([documentId])
  @@index([dueDate])
  @@map("job_invoices")
}

model JobInvoiceLine {
