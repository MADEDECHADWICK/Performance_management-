// =============================
// Prisma Schema v2.1 (Complete)
// HR + Recruitment + Onboarding + Documents + Evaluations
// Jobs + Costing + Time + Payments + Revenue Allocation
// Client Satisfaction + Pipeline/Projections + Workflow Automation
// PostgreSQL
// =============================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// =============================
// ENUMS
// =============================
enum EmployeeKpiAssignmentStatus {
  active
  paused
  closed
}

enum BackgroundCheckStatus {
  pending
  cleared
  flagged
  failed
}

enum TimeEntryApprovalRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum RevenueProjectionStatus {
  projected
  revised
  actualized
  cancelled
}

enum EmployeeStatus {
  active
  inactive
  separated
}

enum OnboardingStatus {
  pending
  in_progress
  completed
}

enum OffboardingStatus {
  initiated
  in_progress
  completed
}

enum RecruitmentStage {
  applied
  shortlisted
  interviewed
  offered
  accepted
  rejected
  hired
}

enum DocumentAccessLevel {
  employee
  manager
  hr
  admin
}

enum DocumentVerificationStatus {
  pending
  verified
  rejected
}

enum ClientStatus {
  active
  inactive
}

enum ClientOnboardingStatus {
  pending_hr_review
  approved
  rejected
  client_created
  job_created
}

enum EngagementLetterStatus {
  uploaded
  pending_review
  approved
  rejected
}

enum JobStatus {
  planned
  in_progress
  on_hold
  completed
  cancelled
}

enum BillingType {
  hourly
  fixed_fee
}

enum Priority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  pending
  in_progress
  blocked
  completed
  cancelled
}

enum TimeEntryStatus {
  pending
  submitted
  approved
  rejected
  cancelled
}

enum OverBudgetRequestStatus {
  pending
  manager_approved
  manager_rejected
  partner_approved
  partner_rejected
  auto_rejected
}

enum BillableType {
  billable
  non_billable
  loss
}

enum EvaluatorType {
  self
  manager
  peer
  direct_report
  client
  custom
}

enum EvaluationDefinitionStatus {
  draft
  published
  closed
}

enum EvaluationAssignmentStatus {
  pending
  in_progress
  submitted
  cancelled
}

enum ProjectEvaluationStatus {
  draft
  submitted
}

enum NotificationType {
  info
  action
  warning
  escalation
}

enum MetricType {
  revenue
  profit
  utilization
  client_satisfaction
  pipeline_value
  jobs_completed
}

enum ProposalStatus {
  draft
  sent
  won
  lost
}

enum WorkflowTriggerType {
  client_onboarding_submitted
  engagement_letter_uploaded
  job_created
  costing_submitted
  budget_exceeded
  time_entry_submitted
  evaluation_due
  job_overdue
}

enum WorkflowAssignmentStatus {
  pending
  in_progress
  completed
  cancelled
  escalated
}

// =============================
// v2.1 PATCH ENUMS (NEW)
// =============================

enum ChecklistStatus {
  pending
  in_progress
  completed
}

enum JobCostingStatus {
  draft
  submitted
  partner_review
  approved
  rejected
}

enum EvaluationCycleStatus {
  draft
  active
  closed
}

enum OkrStatus {
  draft
  active
  completed
  archived
}

enum OkrApprovalStatus {
  draft
  pending
  approved
  rejected
}

enum OkrChangeType {
  progress_update
  status_update
  approval_update
}

enum DashboardStatus {
  on_track
  at_risk
  off_track
}

// =============================
// AUTH + RBAC
// =============================

model User {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  password   String?
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  lastLogin  DateTime?
  resetToken String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile?
  sessions  Session[]
  roles     UserAuthRole[]
  auditLogs AuditLog[]

  @@map("users")
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthRole {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  users       UserAuthRole[]
  permissions AuthRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("auth_roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  description String?

  roles AuthRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserAuthRole {
  userId Int
  roleId Int

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AuthRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_auth_roles")
}

model AuthRolePermission {
  roleId       Int
  permissionId Int

  role       AuthRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("auth_role_permissions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  ipAddress  String?  @map("ip_address")
  metadata   Json?    @map("metadata")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================
// ORG / HR
// =============================

model Department {
  id             Int     @id @default(autoincrement())
  name           String
  description    String?
  departmentCode String? @unique @map("department_code")

  departmentHeadId Int?     @map("department_head_id")
  departmentHead   Profile? @relation("DepartmentHead", fields: [departmentHeadId], references: [id], onDelete: SetNull)

  partnerProfileId Int?     @map("partner_profile_id")
  partner          Profile? @relation("DepartmentPartner", fields: [partnerProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles              Profile[]
  kpis                  Kpi[]
  jobs                  Job[]
  clients               Client[]
  clientOnboardings     ClientOnboarding[]
  recruitmentCandidates RecruitmentCandidate[]
  revenueProjections    RevenueProjection[]
  evaluationDefinitions EvaluationDefinition[]
  dashboardMetrics      DashboardMetric[]
  okrObjectives         OkrObjective[]

  @@index([departmentHeadId])
  @@index([partnerProfileId])
  @@map("departments")
}

model PositionRole {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  billingRate Decimal @default(0) @map("billing_rate") @db.Decimal(12, 2)
  costRate    Decimal @default(0) @map("cost_rate") @db.Decimal(12, 2)

  isActive      Boolean @default(true) @map("is_active")
  defaultAccess Json    @default(dbgenerated("'[]'::jsonb")) @map("default_access")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles            Profile[]
  jobStaffAssignments JobStaffAssignment[]
  jobTimeAllocations  JobTimeAllocation[]
  kpis                Kpi[]

  @@index([name])
  @@map("position_roles")
}

model Profile {
  id     Int  @id @default(autoincrement())
  userId Int? @unique

  firstName  String  @map("first_name")
  middleName String? @map("middle_name")
  lastName   String  @map("last_name")

  phoneNumber    String? @map("phone_number")
  profilePicture String? @map("profile_picture")

  employeeId  String?   @unique @map("employee_id")
  kraPin      String?   @unique @map("kra_pin")
  nssfNumber  String?   @unique @map("nssf_number")
  dateOfBirth DateTime? @map("date_of_birth")

  status        EmployeeStatus @default(active)
  positionTitle String?        @map("position_title")

  departmentId      Int?
  roleId            Int?         @map("role_id")
  departmentsHeaded Department[] @relation("DepartmentHead")
  departmentsAsPartner Department[] @relation("DepartmentPartner")

  hireDate       DateTime? @map("hire_date")
  separationDate DateTime? @map("separation_date")

  managerId     Int?      @map("manager_id")
  manager       Profile?  @relation("ProfileManages", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Profile[] @relation("ProfileManages")

  isPartner Boolean @default(false) @map("is_partner")

  jobCostingsManaged JobCosting[] @relation("JobCostingManager")

  jobTimeAllocations JobTimeAllocation[] @relation("JobTimeAllocationEmployee")

  revenueAllocations RevenueAllocation[] @relation("RevenueAllocationEmployee")

  okrObjectivesOwned OkrObjective[] @relation("OkrObjectiveOwner")

  onboardingStatus             OnboardingStatus @default(pending) @map("onboarding_status")
  onboardingChecklistCompleted Boolean          @default(false) @map("onboarding_checklist_completed")
  inductionCompleted           Boolean          @default(false) @map("induction_completed")

  checklistItemsCompleted InductionChecklistItem[] @relation("ChecklistItemCompletedBy")

  clientOnboardingsUploaded ClientOnboarding[] @relation("ClientOnboardingUploader")
  clientOnboardingsReviewed ClientOnboarding[] @relation("ClientOnboardingReviewer")

  clientsAsPartner Client[] @relation("ClientPartner")
  clientsAsManager Client[] @relation("ClientManager")

  backgroundCheckRequired Boolean                @default(true) @map("background_check_required")
  backgroundCheckStatus   BackgroundCheckStatus? @map("background_check_status")
  backgroundCheckDate     DateTime?              @map("background_check_date")

  statusTransitionsChanged StatusTransition[] @relation("StatusTransitionChangedBy")

  financialTarget   Decimal? @map("financial_target") @db.Decimal(14, 2)
  utilizationTarget Decimal  @default(0.75) @map("utilization_target") @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role       PositionRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  documentsUploaded Document[] @relation("DocUploader")
  documentsVerified Document[] @relation("DocVerifier")

  partner Partner?

  jobsAsPartner Job[] @relation("JobsPartner")
  jobsAsManager Job[] @relation("JobsManager")

  jobStaffAssignments        JobStaffAssignment[]
  jobStaffAssignmentsCreated JobStaffAssignment[] @relation("JobStaffAssignedBy") // v2.1

  timeEntries         TimeEntry[]
  approvedTimeEntries TimeEntry[] @relation("ApprovedTimeEntries")

  timeOverBudgetRequests    TimeOverBudgetRequest[]
  timeEntryApprovalRequests TimeEntryApprovalRequest[]
  timeEntryApprovalsGiven   TimeEntryApprovalRequest[] @relation("TimeEntryApprovalApprover") // v2.1

  evaluationAssignmentsAsEvaluator EvaluationAssignment[] @relation("EvalEvaluator")
  evaluationAssignmentsAsEvaluatee EvaluationAssignment[] @relation("EvalEvaluatee")
  evaluationDefinitionsCreated     EvaluationDefinition[] @relation("EvalCreatedBy")
  projectEvaluationsGiven          ProjectEvaluation[]   @relation("ProjectEvaluationEvaluator")
  projectEvaluationsReceived       ProjectEvaluation[]   @relation("ProjectEvaluationEvaluatee")

  employeeKpiAssignments EmployeeKpiAssignment[]
  employeeKpiScores      EmployeeKpiScore[]
  performanceScores      PerformanceScore[]
  calibratedPerformanceScores PerformanceScore[] @relation("PerformanceScoreCalibratedBy")

  notifications Notification[]

  notificationTemplatesCreated NotificationTemplate[] @relation("NotificationTemplateCreatedBy")

  tasksAssigned Task[] @relation("TaskAssignee")

  feedbackGiven    Feedback[] @relation("FeedbackGiver")
  feedbackReceived Feedback[] @relation("FeedbackRecipient")

  recruitmentCandidatesCreated RecruitmentCandidate[]   @relation("CandidateCreatedBy")
  onboardingCasesAsEmployee    EmployeeOnboardingCase[] @relation("OnboardingEmployee")
  onboardingCasesAsHROwner     EmployeeOnboardingCase[] @relation("OnboardingHROwner")

  offboardingCasesAsEmployee    EmployeeOffboardingCase[] @relation("OffboardingEmployee")
  offboardingCasesAsHROwner     EmployeeOffboardingCase[] @relation("OffboardingHROwner")
  offboardingItemsCompleted     OffboardingChecklistItem[] @relation("OffboardingItemCompletedBy")

  inductionChecklistsAsEmployee InductionChecklist[] @relation("InductionChecklistEmployee")
  inductionChecklistsAsAssigner InductionChecklist[] @relation("InductionChecklistAssigner")

  dashboardMetrics DashboardMetric[] @relation("DashboardMetricPartner")

  workflowAssignments        WorkflowAssignment[] @relation("WorkflowAssignee")
  workflowDefinitionsCreated WorkflowDefinition[] @relation("WorkflowCreatedBy")
  workflowStepEvents         WorkflowStepEvent[]  @relation("WorkflowStepActor") // v2.1

  proposalsCreated   Proposal[] @relation("ProposalCreatedBy") // v2.1
  proposalsAsPartner Proposal[] @relation("ProposalAssignedPartner") // v2.1

  revenueProjectionsCreated RevenueProjection[] @relation("RevenueProjectionCreatedBy") // v2.1

  engagementLettersUploaded EngagementLetter[] @relation("EngagementLetterUploader")
  engagementLettersApproved EngagementLetter[] @relation("EngagementLetterApprover")
  approvedOkrs OkrObjective[] @relation("OkrObjectiveApprovedBy")
  okrHistoryChanges OkrProgressHistory[] @relation("OkrHistoryChangedBy")

  @@index([isPartner])
  @@map("profiles")
}

// =============================
// CONTINUOUS FEEDBACK
// =============================

model Feedback {
  id Int @id @default(autoincrement())

  giverProfileId     Int @map("giver_profile_id")
  recipientProfileId Int @map("recipient_profile_id")

  title   String
  content String
  type    String @default("general")

  isAnonymous Boolean @default(false) @map("is_anonymous")
  status      String  @default("pending")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  giver     Profile @relation("FeedbackGiver", fields: [giverProfileId], references: [id], onDelete: Cascade)
  recipient Profile @relation("FeedbackRecipient", fields: [recipientProfileId], references: [id], onDelete: Cascade)

  @@index([giverProfileId])
  @@index([recipientProfileId])
  @@map("feedback")
}

// =============================
// RECRUITMENT + EMPLOYEE ONBOARDING CASE
// =============================

model RecruitmentCandidate {
  id              Int     @id @default(autoincrement())
  fullName        String  @map("full_name")
  email           String? @map("email")
  phoneNumber     String? @map("phone_number")
  positionApplied String  @map("position_applied")
  departmentId    Int?    @map("department_id")

  stage RecruitmentStage @default(applied)
  notes String?          @db.Text

  createdByProfileId Int?     @map("created_by_profile_id")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  Profile?    @relation("CandidateCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  offerLetterDocumentId Int?      @map("offer_letter_document_id")
  offerLetterDocument   Document? @relation("CandidateOfferLetter", fields: [offerLetterDocumentId], references: [id], onDelete: SetNull)

  onboardingCase EmployeeOnboardingCase?

  @@index([stage])
  @@map("recruitment_candidates")
}

model EmployeeOnboardingCase {
  id          Int  @id @default(autoincrement())
  candidateId Int? @unique @map("candidate_id")
  profileId   Int? @unique @map("profile_id")

  status    OnboardingStatus @default(pending)
  startDate DateTime?        @map("start_date")
  dueDate   DateTime?        @map("due_date")

  hrOwnerProfileId Int?    @map("hr_owner_profile_id")
  notes            String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate RecruitmentCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  employee  Profile?              @relation("OnboardingEmployee", fields: [profileId], references: [id], onDelete: SetNull)
  hrOwner   Profile?              @relation("OnboardingHROwner", fields: [hrOwnerProfileId], references: [id], onDelete: SetNull)

  inductionChecklist InductionChecklist?

  @@map("employee_onboarding_cases")
}

model EmployeeOffboardingCase {
  id        Int              @id @default(autoincrement())
  profileId Int?             @unique @map("profile_id")
  hrOwnerProfileId Int?      @map("hr_owner_profile_id")
  status    OffboardingStatus @default(initiated)
  reason    String?          @map("reason")
  initiatedAt DateTime       @default(now()) @map("initiated_at")
  completedAt DateTime?      @map("completed_at")
  notes     String?

  employee  Profile? @relation("OffboardingEmployee", fields: [profileId], references: [id], onDelete: SetNull)
  hrOwner   Profile? @relation("OffboardingHROwner", fields: [hrOwnerProfileId], references: [id], onDelete: SetNull)
  items     OffboardingChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_offboarding_cases")
}

model OffboardingChecklistItem {
  id               Int      @id @default(autoincrement())
  offboardingCaseId Int     @map("offboarding_case_id")
  itemName         String   @map("item_name")
  description      String?
  orderIndex       Int      @default(0) @map("order_index")
  requiresDocument Boolean  @default(false) @map("requires_document")
  documentId       Int?     @map("document_id")
  isCompleted      Boolean  @default(false) @map("is_completed")
  completedByProfileId Int? @map("completed_by_profile_id")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  offboardingCase EmployeeOffboardingCase @relation(fields: [offboardingCaseId], references: [id], onDelete: Cascade)
  completedBy     Profile? @relation("OffboardingItemCompletedBy", fields: [completedByProfileId], references: [id], onDelete: SetNull)
  document        Document? @relation("OffboardingItemDocument", fields: [documentId], references: [id], onDelete: SetNull)

  @@index([offboardingCaseId])
  @@map("offboarding_checklist_items")
}

model InductionChecklist {
  id                Int  @id @default(autoincrement())
  onboardingCaseId  Int? @unique @map("onboarding_case_id")
  employeeProfileId Int  @map("employee_profile_id")

  checklistName     String          @default("Standard Employee Induction") @map("checklist_name")
  status            ChecklistStatus @default(pending) // v2.1 (was String)
  totalItems        Int             @default(0) @map("total_items")
  completedItems    Int             @default(0) @map("completed_items")
  completionPercent Decimal         @default(0) @map("completion_percent") @db.Decimal(5, 2)

  assignedByProfileId Int?      @map("assigned_by_profile_id")
  dueDate             DateTime? @map("due_date")
  completedAt         DateTime? @map("completed_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboardingCase EmployeeOnboardingCase? @relation(fields: [onboardingCaseId], references: [id], onDelete: SetNull)
  employee       Profile                 @relation("InductionChecklistEmployee", fields: [employeeProfileId], references: [id], onDelete: Cascade)
  assignedBy     Profile?                @relation("InductionChecklistAssigner", fields: [assignedByProfileId], references: [id], onDelete: SetNull)

  items InductionChecklistItem[]

  @@index([employeeProfileId])
  @@map("induction_checklists")
}

model InductionChecklistItem {
  id          Int @id @default(autoincrement())
  checklistId Int @map("checklist_id")

  itemName    String  @map("item_name")
  description String?
  orderIndex  Int     @default(0) @map("order_index")

  isCompleted          Boolean   @default(false) @map("is_completed")
  completedByProfileId Int?      @map("completed_by_profile_id")
  completedAt          DateTime? @map("completed_at")

  requiresDocument Boolean @default(false) @map("requires_document")
  documentId       Int?    @map("document_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklist   InductionChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy Profile?           @relation("ChecklistItemCompletedBy", fields: [completedByProfileId], references: [id], onDelete: SetNull)

  document Document? @relation("ChecklistItemDocument", fields: [documentId], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@map("induction_checklist_items")
}

// =============================
// PARTNERS
// =============================

model PartnerCompany {
  id                 Int     @id @default(autoincrement())
  companyName        String  @unique @map("company_name")
  registrationNumber String? @map("registration_number")
  taxId              String? @map("tax_id")
  bankAccountDetails String? @map("bank_account_details") @db.Text
  contractTerms      String? @map("contract_terms") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partners Partner[]

  @@map("partner_companies")
}

model Partner {
  id        Int @id @default(autoincrement())
  profileId Int @unique @map("profile_id")

  companyId            Int?    @map("company_id")
  commissionRate       Decimal @default(0) @map("commission_rate") @db.Decimal(5, 2)
  performanceThreshold Decimal @default(80) @map("performance_threshold") @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company PartnerCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("partners")
}

// =============================
// DOCUMENTS
// =============================

model Document {
  id       Int     @id @default(autoincrement())
  fileName String  @map("file_name")
  filePath String  @map("file_path")
  fileSize Int?    @map("file_size")
  mimeType String? @map("mime_type")

  documentType String @map("document_type")
  entityType   String @map("entity_type")
  entityId     Int?   @map("entity_id")

  accessLevel DocumentAccessLevel @default(admin) @map("access_level")

  isRequired         Boolean                    @default(false) @map("is_required")
  verificationStatus DocumentVerificationStatus @default(pending) @map("verification_status")
  rejectionReason    String?                    @map("rejection_reason")

  uploadedBy Int?      @map("uploaded_by")
  verifiedBy Int?      @map("verified_by")
  verifiedAt DateTime? @map("verified_at")

  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uploader Profile? @relation("DocUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  verifier Profile? @relation("DocVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  engagementLetters EngagementLetter[] @relation("EngagementLetterDocument")

  candidateOfferLetters RecruitmentCandidate[]   @relation("CandidateOfferLetter")
  checklistItemDocs     InductionChecklistItem[] @relation("ChecklistItemDocument")
  offboardingItemDocs   OffboardingChecklistItem[] @relation("OffboardingItemDocument")

  @@index([entityType, entityId])
  @@index([documentType])
  @@map("documents")
}

// =============================
// CLIENTS + ONBOARDING
// =============================

model ClientOnboarding {
  id            Int    @id @default(autoincrement())
  clientName    String @map("client_name")
  industry      String
  contactPerson String @map("contact_person")
  contactEmail  String @map("contact_email")
  contactPhone  String @map("contact_phone")
  location      String

  uploadedByProfileId Int  @map("uploaded_by_profile_id")
  hrReviewerProfileId Int? @map("hr_reviewer_profile_id")

  engagementLetterId Int                    @map("engagement_letter_id")
  status             ClientOnboardingStatus @default(pending_hr_review)

  departmentId Int? @map("department_id")
  clientId     Int? @unique @map("client_id")
  jobId        Int? @unique @map("job_id")

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagementLetter EngagementLetter @relation(fields: [engagementLetterId], references: [id], onDelete: Restrict)

  uploadedBy Profile  @relation("ClientOnboardingUploader", fields: [uploadedByProfileId], references: [id], onDelete: Restrict)
  hrReviewer Profile? @relation("ClientOnboardingReviewer", fields: [hrReviewerProfileId], references: [id], onDelete: SetNull)

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([uploadedByProfileId])
  @@index([hrReviewerProfileId]) // v2.1 (optional helpful index)
  @@map("client_onboardings")
}

model Client {
  id            Int     @id @default(autoincrement())
  clientName    String  @map("client_name")
  clientCode    String? @unique @map("client_code")
  industry      String?
  contactPerson String? @map("contact_person")
  contactEmail  String? @map("contact_email")
  contactPhone  String? @map("contact_phone")
  address       String?
  location      String?

  departmentId     Int? @map("department_id")
  partnerProfileId Int? @map("partner_profile_id")
  managerProfileId Int? @map("manager_profile_id")

  status    ClientStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  partner    Profile?    @relation("ClientPartner", fields: [partnerProfileId], references: [id], onDelete: SetNull)
  manager    Profile?    @relation("ClientManager", fields: [managerProfileId], references: [id], onDelete: SetNull)

  engagementLetters EngagementLetter[]
  jobs              Job[]
  payments          ClientPayment[]
  statusTransitions StatusTransition[]
  onboarding        ClientOnboarding?

  satisfactionSurveys ClientSatisfactionSurvey[]
  proposals           Proposal[]
  revenueProjections  RevenueProjection[]

  @@index([departmentId])
  @@index([status])
  @@map("clients")
}

model EngagementLetter {
  id       Int @id @default(autoincrement())
  clientId Int @map("client_id")

  documentId Int?      @map("document_id")
  document   Document? @relation("EngagementLetterDocument", fields: [documentId], references: [id], onDelete: SetNull)

  jobTitle       String? @map("job_title")
  engagementType String  @map("engagement_type")

  feeAmount Decimal? @map("fee_amount") @db.Decimal(14, 2)
  currency  String   @default("KES")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  scopeDescription String? @map("scope_description") @db.Text
  termsConditions  String? @map("terms_conditions") @db.Text

  uploadedByProfileId Int? @map("uploaded_by_profile_id")
  approvedByProfileId Int? @map("approved_by_profile_id")

  uploadedBy Profile?  @relation("EngagementLetterUploader", fields: [uploadedByProfileId], references: [id], onDelete: SetNull)
  approvedBy Profile?  @relation("EngagementLetterApprover", fields: [approvedByProfileId], references: [id], onDelete: SetNull)
  approvedAt DateTime? @map("approved_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status EngagementLetterStatus @default(uploaded)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  onboardings       ClientOnboarding[]
  job               Job?
  statusTransitions StatusTransition[]

  @@index([clientId])
  @@index([status])
  @@index([uploadedByProfileId])
  @@index([approvedByProfileId])
  @@map("engagement_letters")
}

// =============================
// JOBS + COSTING + TASKS + TIME
// =============================

model Job {
  id          Int     @id @default(autoincrement())
  jobName     String  @map("job_name")
  jobCode     String? @unique @map("job_code")
  description String?

  clientId     Int? @map("client_id")
  departmentId Int? @map("department_id")

  partnerProfileId Int? @map("partner_profile_id")
  managerProfileId Int? @map("manager_profile_id")

  startDate      DateTime? @map("start_date")
  dueDate        DateTime? @map("due_date")
  completionDate DateTime? @map("completion_date")
  status         JobStatus @default(planned)

  timeEntryApprovalRequests TimeEntryApprovalRequest[]
  timeOverBudgetRequests    TimeOverBudgetRequest[]

  dashboardMetrics DashboardMetric[]

  priority Priority @default(medium)

  billingType    BillingType @default(hourly) @map("billing_type")
  fixedFeeAmount Decimal     @default(0) @map("fixed_fee_amount") @db.Decimal(14, 2)
  budgetHours    Decimal     @default(0) @map("budget_hours") @db.Decimal(10, 2)

  engagementLetterId Int? @unique @map("engagement_letter_id")

  costingCompleted Boolean @default(false) @map("costing_completed")
  teamAssigned     Boolean @default(false) @map("team_assigned")

  clientOnboarding ClientOnboarding?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  partner Profile? @relation("JobsPartner", fields: [partnerProfileId], references: [id], onDelete: SetNull)
  manager Profile? @relation("JobsManager", fields: [managerProfileId], references: [id], onDelete: SetNull)

  engagementLetter EngagementLetter? @relation(fields: [engagementLetterId], references: [id], onDelete: SetNull)

  staffing           JobStaffAssignment[]
  jobCosting         JobCosting?
  tasks              Task[]
  timeEntries        TimeEntry[]
  payments           ClientPayment[]
  revenueAllocations RevenueAllocation[]
  statusTransitions  StatusTransition[]

  surveys ClientSatisfactionSurvey[]
  projectEvaluations ProjectEvaluation[]

  @@index([status])
  @@index([partnerProfileId])
  @@index([managerProfileId])
  @@index([clientId])
  @@map("jobs")
}

model ProjectEvaluation {
  id Int @id @default(autoincrement())

  jobId Int @map("job_id")
  evaluateeProfileId Int @map("evaluatee_profile_id")
  evaluatorProfileId Int @map("evaluator_profile_id")

  evaluatorType EvaluatorType @default(manager) @map("evaluator_type")
  status ProjectEvaluationStatus @default(draft)

  scores Json @default(dbgenerated("'{}'::jsonb"))
  overallScore Decimal? @map("overall_score") @db.Decimal(7, 2)
  comments String? @db.Text
  submittedAt DateTime? @map("submitted_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evaluatee Profile @relation("ProjectEvaluationEvaluatee", fields: [evaluateeProfileId], references: [id], onDelete: Cascade)
  evaluator Profile @relation("ProjectEvaluationEvaluator", fields: [evaluatorProfileId], references: [id], onDelete: Cascade)

  @@unique([jobId, evaluateeProfileId, evaluatorProfileId, evaluatorType])
  @@index([jobId])
  @@index([evaluateeProfileId])
  @@index([evaluatorProfileId])
  @@index([status])
  @@map("project_evaluations")
}

model Task {
  id          Int     @id @default(autoincrement())
  jobId       Int     @map("job_id")
  title       String
  description String?

  assignedToProfileId Int?     @map("assigned_to_profile_id")
  estimatedHours      Decimal? @map("estimated_hours") @db.Decimal(10, 2)

  billable Boolean    @default(true)
  status   TaskStatus @default(pending)
  priority Priority   @default(medium)

  dueDate DateTime? @map("due_date")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignee Profile? @relation("TaskAssignee", fields: [assignedToProfileId], references: [id], onDelete: SetNull)

  timeEntries TimeEntry[]

  @@index([jobId])
  @@index([assignedToProfileId])
  @@index([status])
  @@map("tasks")
}

model JobStaffAssignment {
  id                Int @id @default(autoincrement())
  jobId             Int @map("job_id")
  employeeProfileId Int @map("employee_profile_id")

  assignedRoleId     Int     @map("assigned_role_id")
  assignedHourlyRate Decimal @map("assigned_hourly_rate") @db.Decimal(12, 2)

  roleSnapshot Json?    @map("role_snapshot")
  roleOnJob    String?  @map("role_on_job")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  assignedByProfileId Int?     @map("assigned_by_profile_id") // v2.1: now linked
  assignedBy          Profile? @relation("JobStaffAssignedBy", fields: [assignedByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job      Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee Profile      @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  role     PositionRole @relation(fields: [assignedRoleId], references: [id], onDelete: Restrict)

  @@unique([jobId, employeeProfileId])
  @@index([jobId])
  @@index([employeeProfileId])
  @@index([assignedByProfileId]) // v2.1
  @@map("job_staff_assignments")
}

model JobCosting {
  id               Int @id @default(autoincrement())
  jobId            Int @unique @map("job_id")
  managerProfileId Int @map("manager_profile_id")

  jobFee Decimal @map("job_fee") @db.Decimal(14, 2)

  allocatedCost   Decimal @default(0) @map("allocated_cost") @db.Decimal(14, 2)
  remainingBudget Decimal @default(0) @map("remaining_budget") @db.Decimal(14, 2)

  profitLossIndicator String? @map("profit_loss_indicator")
  warningThreshold    Decimal @default(0.90) @map("warning_threshold") @db.Decimal(5, 2)

  totalEstimatedHours Decimal @default(0) @map("total_estimated_hours") @db.Decimal(10, 2)
  totalEstimatedCost  Decimal @default(0) @map("total_estimated_cost") @db.Decimal(14, 2)

  costingStatus JobCostingStatus @default(draft) @map("costing_status") // v2.1 (was String)

  approvedByPartnerProfileId Int?      @map("approved_by_partner_profile_id")
  approvedAt                 DateTime? @map("approved_at")

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  manager Profile @relation("JobCostingManager", fields: [managerProfileId], references: [id], onDelete: Restrict)

  allocations       JobTimeAllocation[]
  budgetCap         BudgetCap?
  statusTransitions StatusTransition[]

  @@index([managerProfileId])
  @@map("job_costings")
}

model JobTimeAllocation {
  id                Int @id @default(autoincrement())
  jobCostingId      Int @map("job_costing_id")
  employeeProfileId Int @map("employee_profile_id")
  roleId            Int @map("role_id")

  allocatedHours Decimal @default(0) @map("allocated_hours") @db.Decimal(10, 2)
  hourlyRate     Decimal @default(0) @map("hourly_rate") @db.Decimal(12, 2)
  estimatedCost  Decimal @default(0) @map("estimated_cost") @db.Decimal(14, 2)

  billable        Boolean @default(true)
  taskDescription String? @map("task_description")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCosting JobCosting   @relation(fields: [jobCostingId], references: [id], onDelete: Cascade)
  employee   Profile      @relation("JobTimeAllocationEmployee", fields: [employeeProfileId], references: [id], onDelete: Cascade)
  role       PositionRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([jobCostingId, employeeProfileId, roleId])
  @@index([jobCostingId])
  @@map("job_time_allocations")
}

model BudgetCap {
  id           Int @id @default(autoincrement())
  jobCostingId Int @unique @map("job_costing_id")

  totalAllocatedHours Decimal @default(0) @map("total_allocated_hours") @db.Decimal(10, 2)

  capEnforced       Boolean @default(true) @map("cap_enforced")
  allowOverage      Boolean @default(false) @map("allow_overage")
  maxOveragePercent Decimal @default(0.20) @map("max_overage_percent") @db.Decimal(5, 2)
  autoLockOnExceed  Boolean @default(true) @map("auto_lock_on_exceed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCosting JobCosting @relation(fields: [jobCostingId], references: [id], onDelete: Cascade)

  @@map("budget_caps")
}

model TimeEntry {
  id                Int  @id @default(autoincrement())
  jobId             Int  @map("job_id")
  taskId            Int? @map("task_id")
  employeeProfileId Int  @map("employee_profile_id")

  dateWorked DateTime @map("date_worked")

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  hours       Decimal @default(0) @db.Decimal(10, 2)
  billable    Boolean @default(true)
  description String?

  status TimeEntryStatus @default(submitted)

  approvedByProfileId Int?      @map("approved_by_profile_id")
  approvedAt          DateTime? @map("approved_at")

  billableAmount Decimal @default(0) @map("billable_amount") @db.Decimal(14, 2)
  costAmount     Decimal @default(0) @map("cost_amount") @db.Decimal(14, 2)
  profitLoss     Decimal @default(0) @map("profit_loss") @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  employee Profile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  approver Profile? @relation("ApprovedTimeEntries", fields: [approvedByProfileId], references: [id], onDelete: SetNull)

  approvalRequests   TimeEntryApprovalRequest[]
  overBudgetRequests TimeOverBudgetRequest[]

  /// Business rule (enforced in service layer):
  /// Only allow time entry creation when a JobStaffAssignment exists for (employeeProfileId, jobId).

  @@index([employeeProfileId, dateWorked])
  @@index([employeeProfileId, jobId, dateWorked])
  @@index([jobId, dateWorked])
  @@index([jobId]) // optional (hot FK lookups)
  @@index([taskId])
  @@map("time_entries")
}

model TimeEntryApprovalRequest {
  id                Int  @id @default(autoincrement())
  timeEntryId       Int? @map("time_entry_id")
  jobId             Int  @map("job_id")
  employeeProfileId Int  @map("employee_profile_id")

  currentAllocatedHours    Decimal @map("current_allocated_hours") @db.Decimal(10, 2)
  currentLoggedHours       Decimal @map("current_logged_hours") @db.Decimal(10, 2)
  additionalHoursRequested Decimal @map("additional_hours_requested") @db.Decimal(10, 2)

  justification String @db.Text
  requestType   String @map("request_type")

  status              TimeEntryApprovalRequestStatus @default(pending)
  approvedByProfileId Int?                           @map("approved_by_profile_id")
  approvalNotes       String?                        @map("approval_notes")
  approvedAt          DateTime?                      @map("approved_at")
  requestedAt         DateTime                       @default(now()) @map("requested_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntry TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee  Profile    @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  approver Profile? @relation("TimeEntryApprovalApprover", fields: [approvedByProfileId], references: [id], onDelete: SetNull) // v2.1

  @@index([jobId])
  @@index([employeeProfileId])
  @@index([status])
  @@index([approvedByProfileId]) // v2.1
  @@map("time_entry_approval_requests")
}

model TimeOverBudgetRequest {
  id                Int @id @default(autoincrement())
  timeEntryId       Int @map("time_entry_id")
  employeeProfileId Int @map("employee_profile_id")
  jobId             Int @map("job_id")

  allocatedHours      Decimal @map("allocated_hours") @db.Decimal(10, 2)
  loggedHours         Decimal @map("logged_hours") @db.Decimal(10, 2)
  requestedAdditional Decimal @map("requested_additional") @db.Decimal(10, 2)
  totalAfterRequest   Decimal @map("total_after_request") @db.Decimal(10, 2)

  billableType            BillableType @default(billable) @map("billable_type")
  requiresPartnerApproval Boolean      @default(false) @map("requires_partner_approval")

  managerApproved Boolean @default(false) @map("manager_approved")
  partnerApproved Boolean @default(false) @map("partner_approved")

  status OverBudgetRequestStatus @default(pending)

  autoRejected    Boolean @default(false) @map("auto_rejected")
  rejectionReason String? @map("rejection_reason")
  approvalNotes   String? @map("approval_notes")

  estimatedCostImpact Decimal? @map("estimated_cost_impact") @db.Decimal(14, 2)
  wouldExceedBudget   Boolean  @default(false) @map("would_exceed_budget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  employee  Profile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([employeeProfileId])
  @@index([status])
  @@map("time_over_budget_requests")
}

// =============================
// PAYMENTS + REVENUE ALLOCATION
// =============================

model ClientPayment {
  id       Int  @id @default(autoincrement())
  clientId Int  @map("client_id")
  jobId    Int? @map("job_id")

  invoiceNumber   String?  @map("invoice_number")
  paymentAmount   Decimal  @map("payment_amount") @db.Decimal(14, 2)
  currency        String   @default("KES")
  paymentDate     DateTime @map("payment_date")
  paymentMethod   String?  @map("payment_method")
  referenceNumber String?  @map("reference_number")
  notes           String?

  recordedByProfileId Int? @map("recorded_by_profile_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job    Job?   @relation(fields: [jobId], references: [id], onDelete: SetNull)

  revenueAllocations RevenueAllocation[]

  @@index([clientId])
  @@index([jobId])
  @@index([paymentDate])
  @@map("client_payments")
}

model RevenueAllocation {
  id                Int @id @default(autoincrement())
  jobId             Int @map("job_id")
  clientPaymentId   Int @map("client_payment_id")
  employeeProfileId Int @map("employee_profile_id")

  employeeBillable Decimal @map("employee_billable") @db.Decimal(14, 2)
  employeeProfit   Decimal @map("employee_profit") @db.Decimal(14, 2)
  employeeLoss     Decimal @map("employee_loss") @db.Decimal(14, 2)

  totalJobBillable     Decimal @map("total_job_billable") @db.Decimal(14, 2)
  allocationPercentage Decimal @map("allocation_percentage") @db.Decimal(7, 4)
  allocatedAmount      Decimal @map("allocated_amount") @db.Decimal(14, 2)

  allocationMonth DateTime @map("allocation_month")
  isFinalized     Boolean  @default(false) @map("is_finalized")

  calculatedAt DateTime @default(now()) @map("calculated_at")

  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  clientPayment ClientPayment @relation(fields: [clientPaymentId], references: [id], onDelete: Cascade)
  employee      Profile       @relation("RevenueAllocationEmployee", fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([jobId, clientPaymentId, employeeProfileId])
  @@index([allocationMonth])
  @@map("revenue_allocations")
}

// =============================
// CLIENT SATISFACTION SURVEY (Token-based external submission)
// =============================

model ClientSatisfactionSurvey {
  id       Int  @id @default(autoincrement())
  clientId Int  @map("client_id")
  jobId    Int? @map("job_id")

  surveyToken String    @unique @map("survey_token")
  sentAt      DateTime? @map("sent_at")
  expiresAt   DateTime? @map("expires_at")

  qualityRating         Int?     @map("quality_rating")
  communicationRating   Int?     @map("communication_rating")
  timelinessRating      Int?     @map("timeliness_rating")
  professionalismRating Int?     @map("professionalism_rating")
  valueForMoneyRating   Int?     @map("value_for_money_rating")
  overallSatisfaction   Int?     @map("overall_satisfaction")
  wouldRecommend        Boolean? @map("would_recommend")

  improvementSuggestions String? @map("improvement_suggestions") @db.Text
  additionalComments     String? @map("additional_comments") @db.Text

  completedAt DateTime? @map("completed_at")
  ipAddress   String?   @map("ip_address")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job    Job?   @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([jobId])
  @@index([surveyToken])
  @@map("client_satisfaction_surveys")
}

// =============================
// PIPELINE / PROPOSALS / PROJECTIONS
// =============================

model Proposal {
  id       Int @id @default(autoincrement())
  clientId Int @map("client_id")

  proposalTitle String  @map("proposal_title")
  serviceType   String  @map("service_type")
  proposedFee   Decimal @map("proposed_fee") @db.Decimal(14, 2)
  currency      String  @default("KES")

  proposalDate         DateTime  @map("proposal_date")
  expectedStart        DateTime? @map("expected_start")
  expectedDurationDays Int?      @map("expected_duration_days")

  status      ProposalStatus @default(sent)
  probability Int            @default(50)

  createdByProfileId       Int? @map("created_by_profile_id")
  assignedPartnerProfileId Int? @map("assigned_partner_profile_id")

  createdBy       Profile? @relation("ProposalCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull) // v2.1
  assignedPartner Profile? @relation("ProposalAssignedPartner", fields: [assignedPartnerProfileId], references: [id], onDelete: SetNull) // v2.1

  wonAt      DateTime? @map("won_at")
  lostReason String?   @map("lost_reason")

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([proposalDate])
  @@index([createdByProfileId]) // v2.1
  @@index([assignedPartnerProfileId]) // v2.1
  @@map("proposals")
}

model RevenueProjection {
  id           Int  @id @default(autoincrement())
  clientId     Int? @map("client_id")
  departmentId Int? @map("department_id")

  monthYear       DateTime @map("month_year")
  projectedAmount Decimal  @map("projected_amount") @db.Decimal(14, 2)
  currency        String   @default("KES")

  actualCollected Decimal @default(0) @map("actual_collected") @db.Decimal(14, 2)
  variance        Decimal @default(0) @map("variance") @db.Decimal(14, 2)
  variancePercent Decimal @default(0) @map("variance_percent") @db.Decimal(7, 2)

  status RevenueProjectionStatus @default(projected)

  createdByProfileId Int?     @map("created_by_profile_id")
  createdBy          Profile? @relation("RevenueProjectionCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull) // v2.1

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([clientId, departmentId, monthYear])
  @@index([monthYear])
  @@index([createdByProfileId]) // v2.1
  @@map("revenue_projections")
}

// =============================
// KPI + TARGETS
// =============================

model Kpi {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  category    String
  kpiType     String  @map("kpi_type")

  measurementUnit String? @map("measurement_unit")
  currency        String? @default("KES")

  targetValue       Decimal? @map("target_value") @db.Decimal(14, 2)
  targetFrequency   String?  @map("target_frequency")
  targetDescription String?  @map("target_description")

  weight Decimal? @db.Decimal(5, 2)

  departmentId Int? @map("department_id")
  roleId       Int? @map("role_id")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role       PositionRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  employeeAssignments EmployeeKpiAssignment[]
  employeeScores      EmployeeKpiScore[]

  @@index([category])
  @@index([kpiType])
  @@map("kpis")
}

model EmployeeKpiAssignment {
  id                Int @id @default(autoincrement())
  employeeProfileId Int @map("employee_profile_id")
  kpiId             Int @map("kpi_id")

  targetValue   Decimal? @map("target_value") @db.Decimal(14, 2)
  achievedValue Decimal? @map("achieved_value") @db.Decimal(14, 2)
  weight        Decimal? @db.Decimal(5, 2)

  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")

  status EmployeeKpiAssignmentStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Profile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  kpi      Kpi     @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, kpiId, periodStart, periodEnd])
  @@index([employeeProfileId])
  @@map("employee_kpi_assignments")
}

model EmployeeKpiScore {
  id                Int @id @default(autoincrement())
  employeeProfileId Int @map("employee_profile_id")
  kpiId             Int @map("kpi_id")

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  calculatedValue    Decimal @map("calculated_value") @db.Decimal(14, 2)
  targetValue        Decimal @map("target_value") @db.Decimal(14, 2)
  achievementPercent Decimal @map("achievement_percent") @db.Decimal(7, 2)

  weightPercent Decimal @map("weight_percent") @db.Decimal(5, 2)
  weightedScore Decimal @map("weighted_score") @db.Decimal(7, 2)

  notes        String?
  calculatedAt DateTime @default(now()) @map("calculated_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Profile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  kpi      Kpi     @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, kpiId, periodStart, periodEnd])
  @@index([employeeProfileId])
  @@map("employee_kpi_scores")
}

// =============================
// EVALUATIONS
// =============================

model EvaluationCycle {
  id          Int      @id @default(autoincrement())
  cycleName   String   @map("cycle_name")
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")

  status EvaluationCycleStatus @default(draft) // v2.1 (was String)

  createdByProfileId Int?     @map("created_by_profile_id")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  definitions       EvaluationDefinition[]
  performanceScores PerformanceScore[]
  okrObjectives     OkrObjective[]

  @@map("evaluation_cycles")
}

model EvaluationDefinition {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  cycleId      Int? @map("cycle_id")
  departmentId Int? @map("department_id")

  enableSelfEvaluation     Boolean @default(false) @map("enable_self_evaluation")
  enablePeerEvaluation     Boolean @default(false) @map("enable_peer_evaluation")
  enableUpwardEvaluation   Boolean @default(false) @map("enable_upward_evaluation")
  enableDownwardEvaluation Boolean @default(false) @map("enable_downward_evaluation")
  enableClientEvaluation   Boolean @default(false) @map("enable_client_evaluation")

  dueDate                   DateTime? @map("due_date")
  processAnonymously        Boolean   @default(false) @map("process_anonymously")
  hideFromDashboard         Boolean   @default(false) @map("hide_from_dashboard")
  excludeFromScore          Boolean   @default(false) @map("exclude_from_score")
  requireEvaluatorSignature Boolean   @default(false) @map("require_evaluator_signature")
  requireEvaluateeSignature Boolean   @default(false) @map("require_evaluatee_signature")

  status EvaluationDefinitionStatus @default(draft)

  createdByProfileId Int?      @map("created_by_profile_id")
  publishedAt        DateTime? @map("published_at")

  questions     Json @default(dbgenerated("'[]'::jsonb"))
  scoringConfig Json @default(dbgenerated("'{}'::jsonb")) @map("scoring_config")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle      EvaluationCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  department Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdBy Profile? @relation("EvalCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  assignments EvaluationAssignment[]

  @@index([status])
  @@map("evaluation_definitions")
}

model EvaluationAssignment {
  id                     Int @id @default(autoincrement())
  evaluationDefinitionId Int @map("evaluation_definition_id")

  evaluatorProfileId Int @map("evaluator_profile_id")
  evaluateeProfileId Int @map("evaluatee_profile_id")

  evaluatorType EvaluatorType @default(manager) @map("evaluator_type")

  status EvaluationAssignmentStatus @default(pending)

  responses    Json?    @map("responses")
  score        Decimal? @map("score") @db.Decimal(7, 2)
  evidenceUrls String[] @map("evidence_urls")

  evaluatorComments String?   @map("evaluator_comments") @db.Text
  submittedAt       DateTime? @map("submitted_at")

  evaluatorSigned   Boolean   @default(false) @map("evaluator_signed")
  evaluatorSignedAt DateTime? @map("evaluator_signed_at")

  evaluateeAcknowledged   Boolean   @default(false) @map("evaluatee_acknowledged")
  evaluateeAcknowledgedAt DateTime? @map("evaluatee_acknowledged_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  definition EvaluationDefinition @relation(fields: [evaluationDefinitionId], references: [id], onDelete: Cascade)

  evaluator Profile @relation("EvalEvaluator", fields: [evaluatorProfileId], references: [id], onDelete: Cascade)
  evaluatee Profile @relation("EvalEvaluatee", fields: [evaluateeProfileId], references: [id], onDelete: Cascade)

  @@unique([evaluationDefinitionId, evaluatorProfileId, evaluateeProfileId, evaluatorType])
  @@index([evaluateeProfileId, status])
  @@map("evaluation_assignments")
}

// =============================
// OKR (Objectives & Key Results)
// =============================

model OkrObjective {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      OkrStatus @default(active)
  approvalStatus OkrApprovalStatus @default(pending) @map("approval_status")

  ownerProfileId Int @map("owner_profile_id")
  departmentId   Int? @map("department_id")
  cycleId        Int? @map("cycle_id")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  approvedByProfileId Int? @map("approved_by_profile_id")
  approvalNotes String? @map("approval_notes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      Profile     @relation("OkrObjectiveOwner", fields: [ownerProfileId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  cycle      EvaluationCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  approvedBy Profile? @relation("OkrObjectiveApprovedBy", fields: [approvedByProfileId], references: [id], onDelete: SetNull)

  keyResults OkrKeyResult[]
  history    OkrProgressHistory[]

  @@index([ownerProfileId])
  @@index([departmentId])
  @@map("okr_objectives")
}

model OkrKeyResult {
  id          Int     @id @default(autoincrement())
  objectiveId Int     @map("objective_id")
  title       String
  unit        String? @map("unit")

  targetValue Decimal @map("target_value") @db.Decimal(12, 2)
  currentValue Decimal @default(0) @map("current_value") @db.Decimal(12, 2)
  weight      Decimal? @map("weight") @db.Decimal(5, 2)

  status OkrStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  objective OkrObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  history   OkrProgressHistory[]

  @@index([objectiveId])
  @@map("okr_key_results")
}

model OkrProgressHistory {
  id            Int          @id @default(autoincrement())
  objectiveId   Int          @map("objective_id")
  keyResultId   Int?         @map("key_result_id")
  changeType    OkrChangeType @map("change_type")
  field         String       @map("field")
  previousValue String?      @map("previous_value")
  newValue      String?      @map("new_value")
  note          String?      @map("note")
  changedAt     DateTime     @default(now()) @map("changed_at")

  changedByProfileId Int? @map("changed_by_profile_id")

  objective OkrObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult OkrKeyResult? @relation(fields: [keyResultId], references: [id], onDelete: SetNull)
  changedBy Profile? @relation("OkrHistoryChangedBy", fields: [changedByProfileId], references: [id], onDelete: SetNull)

  @@index([objectiveId])
  @@index([keyResultId])
  @@map("okr_progress_history")
}

model EvaluationTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  templateType String  @map("template_type")
  bscCategory  String? @map("bsc_category")

  competencies Json @default(dbgenerated("'[]'::jsonb"))
  questions    Json @default(dbgenerated("'[]'::jsonb"))

  isActive  Boolean  @default(true) @map("is_active")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([templateType])
  @@map("evaluation_templates")
}

// =============================
// PERFORMANCE SCORE
// =============================

model PerformanceScore {
  id                Int  @id @default(autoincrement())
  employeeProfileId Int  @map("employee_profile_id")
  evaluationCycleId Int? @map("evaluation_cycle_id")

  period DateTime @map("period")

  revenueScore      Decimal @default(0) @map("revenue_score") @db.Decimal(7, 2)
  profitScore       Decimal @default(0) @map("profit_score") @db.Decimal(7, 2)
  utilizationScore  Decimal @default(0) @map("utilization_score") @db.Decimal(7, 2)
  financialWeighted Decimal @default(0) @map("financial_weighted") @db.Decimal(7, 2)

  evaluationScore      Decimal @default(0) @map("evaluation_score") @db.Decimal(7, 2)
  kpiScore             Decimal @default(0) @map("kpi_score") @db.Decimal(7, 2)
  clientRatingScore    Decimal @default(0) @map("client_rating_score") @db.Decimal(7, 2)
  nonFinancialWeighted Decimal @default(0) @map("non_financial_weighted") @db.Decimal(7, 2)

  totalScore Decimal @default(0) @map("total_score") @db.Decimal(7, 2)
  grade      String? @map("grade")

  calibratedScore     Decimal?  @map("calibrated_score") @db.Decimal(7, 2)
  calibrationNote     String?   @map("calibration_note")
  calibratedByProfileId Int?    @map("calibrated_by_profile_id")
  calibratedAt        DateTime? @map("calibrated_at")

  scoreBreakdown Json    @default(dbgenerated("'{}'::jsonb")) @map("score_breakdown")
  notes          String? @db.Text

  calculatedAt DateTime @default(now()) @map("calculated_at")

  employee Profile          @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  cycle    EvaluationCycle? @relation(fields: [evaluationCycleId], references: [id], onDelete: SetNull)
  calibratedBy Profile?     @relation("PerformanceScoreCalibratedBy", fields: [calibratedByProfileId], references: [id], onDelete: SetNull)

  @@unique([employeeProfileId, evaluationCycleId, period])
  @@index([employeeProfileId])
  @@index([period])
  @@map("performance_scores")
}

// =============================
// DASHBOARD METRICS
// =============================

model DashboardMetric {
  id         Int        @id @default(autoincrement())
  metricType MetricType @map("metric_type")
  period     DateTime   @map("period")

  departmentId     Int? @map("department_id")
  partnerProfileId Int? @map("partner_profile_id")
  jobId            Int? @map("job_id")

  value           Decimal  @map("value") @db.Decimal(14, 2)
  target          Decimal? @map("target") @db.Decimal(14, 2)
  variance        Decimal? @map("variance") @db.Decimal(14, 2)
  variancePercent Decimal? @map("variance_percent") @db.Decimal(7, 2)

  status DashboardStatus @default(on_track) // v2.1 (was String)
  trend  String?

  contextData  Json?    @map("context_data")
  calculatedAt DateTime @default(now()) @map("calculated_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  partner    Profile?    @relation("DashboardMetricPartner", fields: [partnerProfileId], references: [id], onDelete: SetNull)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([metricType, period])
  @@index([departmentId, period])
  @@map("dashboard_metrics")
}

// =============================
// NOTIFICATIONS + STATUS TRANSITIONS
// =============================

model Notification {
  id        Int @id @default(autoincrement())
  profileId Int @map("profile_id")

  title   String
  message String
  type    NotificationType @default(info)

  actionRequired  Boolean   @default(false) @map("action_required")
  dueDate         DateTime? @map("due_date")
  escalationLevel Int       @default(1) @map("escalation_level")

  jobId                  Int? @map("job_id")
  clientId               Int? @map("client_id")
  evaluationDefinitionId Int? @map("evaluation_definition_id")
  timeEntryId            Int? @map("time_entry_id")
  workflowAssignmentId   Int? @map("workflow_assignment_id")

  isRead Boolean @default(false) @map("is_read")
  link   String?

  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id        Int @id @default(autoincrement())
  label     String
  title     String
  message   String
  type      NotificationType @default(info)

  actionRequired Boolean @default(false) @map("action_required")
  isActive  Boolean @default(true) @map("is_active")

  createdByProfileId Int? @map("created_by_profile_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy Profile? @relation("NotificationTemplateCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("notification_templates")
}

model StatusTransition {
  id         Int    @id @default(autoincrement())
  entityType String @map("entity_type")
  entityId   Int    @map("entity_id")

  fromStatus String @map("from_status")
  toStatus   String @map("to_status")

  changedByProfileId Int?    @map("changed_by_profile_id")
  reason             String?
  metadata           Json?   @map("metadata")

  createdAt DateTime @default(now())

  changedBy Profile? @relation("StatusTransitionChangedBy", fields: [changedByProfileId], references: [id], onDelete: SetNull)

  clientId     Int? @map("client_id")
  jobId        Int? @map("job_id")
  jobCostingId Int? @map("job_costing_id")

  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobCosting JobCosting? @relation(fields: [jobCostingId], references: [id], onDelete: SetNull)

  engagementLetterId Int?              @map("engagement_letter_id")
  engagementLetter   EngagementLetter? @relation(fields: [engagementLetterId], references: [id], onDelete: SetNull)

  @@index([engagementLetterId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("status_transitions")
}

// =============================
// WORKFLOW AUTOMATION
// =============================

model WorkflowDefinition {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  triggerType WorkflowTriggerType @map("trigger_type")
  entityType  String              @map("entity_type") // "Job", "ClientOnboarding", etc.

  conditions      Json  @default(dbgenerated("'{}'::jsonb")) @map("conditions")
  actions         Json  @default(dbgenerated("'[]'::jsonb")) @map("actions")
  escalationRules Json? @map("escalation_rules")

  isActive Boolean @default(true) @map("is_active")
  priority Int     @default(1) @map("priority")

  createdByProfileId Int? @map("created_by_profile_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   Profile?             @relation("WorkflowCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)
  assignments WorkflowAssignment[]

  @@index([triggerType, isActive])
  @@map("workflow_definitions")
}

model WorkflowAssignment {
  id                   Int @id @default(autoincrement())
  workflowDefinitionId Int @map("workflow_definition_id")

  entityType String @map("entity_type")
  entityId   Int    @map("entity_id")

  assignedToProfileId Int                      @map("assigned_to_profile_id")
  status              WorkflowAssignmentStatus @default(pending)

  currentStep    Int  @default(1) @map("current_step")
  completedSteps Json @default(dbgenerated("'[]'::jsonb")) @map("completed_steps")

  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  escalatedAt DateTime? @map("escalated_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  assignee           Profile            @relation("WorkflowAssignee", fields: [assignedToProfileId], references: [id], onDelete: Cascade)

  stepEvents WorkflowStepEvent[] // v2.1

  @@index([assignedToProfileId, status])
  @@index([entityType, entityId])
  @@index([workflowDefinitionId])
  @@map("workflow_assignments")
}

// =============================
// v2.1: WORKFLOW STEP EVENT (NEW - proper workflow history)
// =============================

model WorkflowStepEvent {
  id                   Int @id @default(autoincrement())
  workflowAssignmentId Int @map("workflow_assignment_id")

  stepName String  @map("step_name")
  action   String  @map("action") // "completed"|"rejected"|"escalated"|etc.
  notes    String? @db.Text

  actedByProfileId Int?     @map("acted_by_profile_id")
  actedAt          DateTime @default(now()) @map("acted_at")

  metadata Json? @map("metadata")

  assignment WorkflowAssignment @relation(fields: [workflowAssignmentId], references: [id], onDelete: Cascade)
  actedBy    Profile?           @relation("WorkflowStepActor", fields: [actedByProfileId], references: [id], onDelete: SetNull)

  @@index([workflowAssignmentId, actedAt])
  @@index([actedByProfileId])
  @@map("workflow_step_events")
}
