  updatedAt        DateTime               @updatedAt @map("updated_at")

  assignment LearningAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  manager    Profile                  @relation("ImpactAssessmentManager", fields: [managerProfileId], references: [id], onDelete: Restrict)
