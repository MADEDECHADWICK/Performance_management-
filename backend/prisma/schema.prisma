// =============================
// LEAVE MANAGEMENT
// =============================

model LeaveType {
  id Int @id @default(autoincrement())

  code        String  @unique
  name        String
  description String?
  color       String?

  isActive            Boolean       @default(true) @map("is_active")
  isPaid              Boolean       @default(true) @map("is_paid")
  balanceTracked      Boolean       @default(true) @map("balance_tracked")
  requiresAttachment  Boolean       @default(false) @map("requires_attachment")
  allowsHalfDay       Boolean       @default(true) @map("allows_half_day")
  unitType            LeaveUnitType @default(day) @map("unit_type")
  defaultNoticeDays   Int           @default(0) @map("default_notice_days")
  defaultMaxUnits     Decimal?      @map("default_max_units") @db.Decimal(8, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  policies      LeavePolicy[]
  requests      LeaveRequest[]
  balances      LeaveBalance[]
  ledgerEntries LeaveLedgerEntry[]

  @@index([isActive])
  @@map("leave_types")
}

model LeavePolicy {
  id Int @id @default(autoincrement())

  leaveTypeId  Int     @map("leave_type_id")
  name         String
  description  String?
  isActive     Boolean @default(true) @map("is_active")

  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  annualEntitlement  Decimal @default(0) @map("annual_entitlement") @db.Decimal(8, 2)
  carryoverCap       Decimal @default(0) @map("carryover_cap") @db.Decimal(8, 2)
  accrualEnabled     Boolean @default(true) @map("accrual_enabled")
  accrualFrequency   LeaveAccrualFrequency @default(monthly) @map("accrual_frequency")
  accrualRate        Decimal @default(0) @map("accrual_rate") @db.Decimal(8, 2)
  requiresManagerApproval Boolean @default(true) @map("requires_manager_approval")
  requiresHrApproval      Boolean @default(false) @map("requires_hr_approval")
  excludeWeekends         Boolean @default(true) @map("exclude_weekends")
  excludePublicHolidays   Boolean @default(true) @map("exclude_public_holidays")
  minNoticeDays           Int     @default(0) @map("min_notice_days")
  hoursPerWorkday         Decimal @default(8) @map("hours_per_workday") @db.Decimal(6, 2)
  autoProjectToTimesheet  Boolean @default(true) @map("auto_project_to_timesheet")
  maxConsecutiveUnits     Decimal @default(0) @map("max_consecutive_units") @db.Decimal(8, 2)
  maxUnitsPerRequest      Decimal @default(0) @map("max_units_per_request") @db.Decimal(8, 2)
  allowNegativeBalance    Boolean @default(false) @map("allow_negative_balance")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leaveType   LeaveType               @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  assignments LeavePolicyAssignment[]
  requests    LeaveRequest[]
