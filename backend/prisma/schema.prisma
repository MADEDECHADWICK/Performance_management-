  learningAttendanceMarked            LearningAttendanceRecord[]     @relation("LearningAttendanceMarkedBy")
  trainingFeedbackReceivedAsTrainer   TrainingFeedback[]             @relation("TrainingFeedbackTrainer")
  impactAssessmentTasksOwned          ImpactAssessmentTask[]         @relation("ImpactAssessmentManager")
