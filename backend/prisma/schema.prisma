// =============================
// Prisma Schema v2.1 (Complete)
// HR + Recruitment + Onboarding + Documents + Evaluations
// Jobs + Costing + Time + Payments + Revenue Allocation
// Client Satisfaction + Pipeline/Projections + Workflow Automation
// PostgreSQL
// =============================

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

